{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bitacora.local/remote/contract/v1/event.schema.json",
  "title": "Bitácora Remote Event v1",
  "type": "object",
  "required": ["id", "kind", "occurredAt", "data"],
  "properties": {
    "id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "kind": {
      "type": "string",
      "enum": ["run.updated", "task.failed", "task.blocked", "run.finished", "question.waiting", "plan.review", "quota.exhausted", "attempt.stale", "laptop.offline", "command.completed"]
    },
    "occurredAt": { "type": "string", "format": "date-time" },
    "data": { "type": "object" }
  },
  "additionalProperties": false
}
