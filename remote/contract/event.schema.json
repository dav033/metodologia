{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flow-remote.invalid/contract/v1/event.schema.json",
  "title": "Bitácora remote event v1",
  "type": "object",
  "required": ["schemaVersion", "id", "cursor", "type", "occurredAt", "target", "data"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1, "maxLength": 160 },
    "cursor": { "type": "string", "minLength": 1, "maxLength": 256 },
    "type": { "enum": ["attempt.failed", "attempt.blocked", "run.finished", "round.waiting", "plan.waiting", "quota.exhausted", "attempt.stalled", "laptop.offline", "command.updated"] },
    "occurredAt": { "type": "string", "format": "date-time", "description": "RFC 3339 timestamp normalized to UTC. Legacy naive laptop timestamps are interpreted in the laptop's local timezone before conversion." },
    "target": { "$ref": "command.schema.json#/$defs/target" },
    "data": { "type": "object" },
    "dedupeKey": { "type": "string", "minLength": 1, "maxLength": 256 }
  },
  "additionalProperties": false
}
