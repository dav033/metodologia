        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "confirmation": {
          "$ref": "#/$defs/Confirmation"
        },
        "type": {
          "const": "delete-plan",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/PlanTarget"
        }
      },
      "required": [
        "schemaVersion",
        "idempotencyKey",
        "precondition",
        "confirmation",
        "type",
        "target"
      ],
      "type": "object"
    },
    "EditBriefCommand": {
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1,
          "type": "integer"
        },
        "idempotencyKey": {
          "maxLength": 120,
          "minLength": 16,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "type": "string"
        },
        "precondition": {
          "$ref": "#/$defs/Precondition"
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "confirmation": {
          "$ref": "#/$defs/Confirmation"
        },
        "type": {
          "const": "edit-brief",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/TaskTarget"
        },
        "field": {
          "enum": [
            "brief",
            "objective",
            "criteria",
            "acceptance_criteria"
          ],
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "maxLength": 20000,
              "minLength": 1,
              "type": "string"
            },
            {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "type": "array"
            }
          ]
        }
      },
      "required": [
        "schemaVersion",
        "idempotencyKey",
        "precondition",
        "confirmation",
        "type",
        "target",
        "field",
        "value"
      ],
      "type": "object"
    },
    "LaunchCommand": {
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1,
          "type": "integer"
        },
        "idempotencyKey": {
