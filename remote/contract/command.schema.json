            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "confirmation": {
          "$ref": "#/$defs/Confirmation"
        },
        "type": {
          "const": "launch",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/PlanTarget"
        }
      },
      "required": [
        "schemaVersion",
        "idempotencyKey",
        "precondition",
        "confirmation",
        "type",
        "target"
      ],
      "type": "object"
    },
    "NoteCommand": {
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1,
          "type": "integer"
        },
        "idempotencyKey": {
          "maxLength": 120,
          "minLength": 16,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "type": "string"
        },
        "precondition": {
          "$ref": "#/$defs/Precondition"
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "type": {
          "const": "note",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/RunTarget"
        },
        "note": {
          "maxLength": 4000,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "schemaVersion",
        "idempotencyKey",
        "precondition",
        "type",
        "target",
        "note"
      ],
      "type": "object"
    },
    "PauseCommand": {
      "additionalProperties": false,
