          "type": "string"
        },
        "precondition": {
          "$ref": "#/$defs/Precondition"
        },
        "reason": {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        },
        "type": {
          "const": "cancel-attempt",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/AttemptTarget"
        }
      },
      "required": [
        "schemaVersion",
        "idempotencyKey",
        "precondition",
        "reason",
        "type",
        "target"
      ],
      "type": "object"
    },
    "CancelPlanCommand": {
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1,
          "type": "integer"
        },
        "idempotencyKey": {
          "maxLength": 120,
          "minLength": 16,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "type": "string"
        },
        "precondition": {
          "$ref": "#/$defs/Precondition"
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "confirmation": {
          "$ref": "#/$defs/Confirmation"
        },
        "type": {
          "const": "cancel-plan",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/PlanTarget"
        }
      },
      "required": [
        "schemaVersion",
        "idempotencyKey",
        "precondition",
        "confirmation",
        "type",
        "target"
      ],
      "type": "object"
    },
    "Confirmation": {
      "additionalProperties": false,
      "properties": {
        "challengeId": {
          "description": "Opaque, one-use id returned by POST /challenges for this exact target.",
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "typedReq": {
          "pattern": "^REQ-[0-9]{3,}$",
          "type": "string"
        }
      },
      "required": [
        "challengeId",
        "typedReq"
      ],
      "type": "object"
    },
    "DeletePlanCommand": {
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1,
          "type": "integer"
        },
        "idempotencyKey": {
          "maxLength": 120,
