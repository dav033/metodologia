          "type": "string"
        },
        "precondition": {
          "$ref": "#/$defs/Precondition"
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "type": {
          "const": "pause",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/RunTarget"
        }
      },
      "required": [
        "schemaVersion",
        "idempotencyKey",
        "precondition",
        "type",
        "target"
      ],
      "type": "object"
    },
    "PlanTarget": {
      "additionalProperties": false,
      "properties": {
        "project": {
          "maxLength": 80,
          "minLength": 1,
          "type": "string"
        },
        "req": {
          "pattern": "^REQ-[0-9]{3,}$",
          "type": "string"
        },
        "kind": {
          "const": "plan",
          "type": "string"
        }
      },
      "required": [
        "project",
        "req",
        "kind"
      ],
      "type": "object"
    },
    "Precondition": {
      "additionalProperties": false,
      "properties": {
        "state": {
          "maxLength": 80,
          "minLength": 1,
          "type": "string"
        },
        "revision": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "updatedAt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "state"
      ],
      "type": "object"
    },
    "ReopenCommand": {
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1,
          "type": "integer"
        },
        "idempotencyKey": {
          "maxLength": 120,
          "minLength": 16,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "type": "string"
        },
        "precondition": {
          "$ref": "#/$defs/Precondition"
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "type": {
          "const": "reopen",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/TaskTarget",
          "description": "Reopen always names the task; the precondition is that task's state."
        }
      },
      "required": [
        "schemaVersion",
        "idempotencyKey",
        "precondition",
        "type",
        "target"
      ],
      "type": "object"
    },
    "ResumeCommand": {
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1,
          "type": "integer"
        },
        "idempotencyKey": {
          "maxLength": 120,
          "minLength": 16,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "type": "string"
        },
        "precondition": {
          "$ref": "#/$defs/Precondition"
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "type": {
          "const": "resume",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/RunTarget"
        }
      },
      "required": [
        "schemaVersion",
        "idempotencyKey",
        "precondition",
        "type",
        "target"
      ],
      "type": "object"
    },
    "RetryCommand": {
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1,
          "type": "integer"
        },
        "idempotencyKey": {
          "maxLength": 120,
          "minLength": 16,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "type": "string"
        },
        "precondition": {
          "$ref": "#/$defs/Precondition"
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "type": {
          "const": "retry",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/TaskTarget"
        },
        "route": {
          "anyOf": [
            {
              "$ref": "#/$defs/RouteSelector"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "schemaVersion",
        "idempotencyKey",
        "precondition",
        "type",
        "target"
      ],
      "type": "object"
    },
    "ReviseCommand": {
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1,
          "type": "integer"
        },
        "idempotencyKey": {
          "maxLength": 120,
          "minLength": 16,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "type": "string"
        },
        "precondition": {
          "$ref": "#/$defs/Precondition"
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "confirmation": {
          "$ref": "#/$defs/Confirmation"
        },
        "type": {
          "const": "revise",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/RunTarget"
        }
      },
      "required": [
        "schemaVersion",
        "idempotencyKey",
        "precondition",
        "confirmation",
        "type",
        "target"
      ],
      "type": "object"
    },
    "RoundTarget": {
      "additionalProperties": false,
      "properties": {
        "project": {
          "maxLength": 80,
          "minLength": 1,
          "type": "string"
        },
        "req": {
          "pattern": "^REQ-[0-9]{3,}$",
          "type": "string"
        },
        "kind": {
          "const": "round",
          "type": "string"
        },
        "roundId": {
          "maxLength": 120,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "project",
        "req",
        "kind",
        "roundId"
      ],
      "type": "object"
    },
    "RouteSelector": {
      "additionalProperties": false,
      "properties": {
        "routeId": {
          "minLength": 1,
          "type": "string"
        },
        "provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "account": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "routeId"
      ],
      "type": "object"
    },
    "RunTarget": {
      "additionalProperties": false,
      "properties": {
        "project": {
          "maxLength": 80,
          "minLength": 1,
          "type": "string"
        },
        "req": {
          "pattern": "^REQ-[0-9]{3,}$",
          "type": "string"
        },
        "kind": {
          "const": "run",
          "type": "string"
        },
        "taskId": {
          "anyOf": [
            {
              "maxLength": 120,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The task a run-level decision is about, if any."
        }
      },
      "required": [
        "project",
        "req",
        "kind"
      ],
      "type": "object"
    },
    "TaskTarget": {
      "additionalProperties": false,
      "properties": {
        "project": {
          "maxLength": 80,
          "minLength": 1,
          "type": "string"
        },
        "req": {
          "pattern": "^REQ-[0-9]{3,}$",
          "type": "string"
        },
        "kind": {
          "const": "task",
          "type": "string"
        },
        "taskId": {
          "maxLength": 120,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "project",
        "req",
        "kind",
        "taskId"
      ],
      "type": "object"
    }
  },
  "description": "A command the phone or the Telegram bot posts to the gateway. Every variant is idempotent and guarded.",
  "discriminator": {
    "mapping": {
      "answer-decision": "#/$defs/AnswerDecisionCommand",
      "answer-round": "#/$defs/AnswerRoundCommand",
      "approve": "#/$defs/ApproveCommand",
      "cancel-attempt": "#/$defs/CancelAttemptCommand",
      "cancel-plan": "#/$defs/CancelPlanCommand",
      "delete-plan": "#/$defs/DeletePlanCommand",
      "edit-brief": "#/$defs/EditBriefCommand",
      "launch": "#/$defs/LaunchCommand",
      "note": "#/$defs/NoteCommand",
      "pause": "#/$defs/PauseCommand",
      "reopen": "#/$defs/ReopenCommand",
      "resume": "#/$defs/ResumeCommand",
      "retry": "#/$defs/RetryCommand",
      "revise": "#/$defs/ReviseCommand"
    },
    "propertyName": "type"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/PauseCommand"
    },
    {
      "$ref": "#/$defs/ResumeCommand"
    },
    {
      "$ref": "#/$defs/CancelAttemptCommand"
    },
    {
      "$ref": "#/$defs/ReopenCommand"
    },
    {
      "$ref": "#/$defs/RetryCommand"
    },
    {
      "$ref": "#/$defs/ReviseCommand"
    },
    {
      "$ref": "#/$defs/ApproveCommand"
    },
    {
      "$ref": "#/$defs/LaunchCommand"
    },
    {
      "$ref": "#/$defs/AnswerDecisionCommand"
    },
    {
      "$ref": "#/$defs/AnswerRoundCommand"
    },
    {
      "$ref": "#/$defs/CancelPlanCommand"
    },
    {
      "$ref": "#/$defs/DeletePlanCommand"
    },
    {
      "$ref": "#/$defs/EditBriefCommand"
    },
    {
      "$ref": "#/$defs/NoteCommand"
    }
  ]
}
