{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bitacora.local/remote/contract/v1/command.schema.json",
  "title": "Bitácora Remote Command v1",
  "description": "One authenticated, idempotent command accepted by the laptop API. Confirmation challenges are single-use and expire after 120 seconds.",
  "oneOf": [
    { "$ref": "#/$defs/pause" },
    { "$ref": "#/$defs/resume" },
    { "$ref": "#/$defs/cancelAttempt" },
    { "$ref": "#/$defs/reopen" },
    { "$ref": "#/$defs/retry" },
    { "$ref": "#/$defs/revise" },
    { "$ref": "#/$defs/approve" },
    { "$ref": "#/$defs/launch" },
    { "$ref": "#/$defs/answerRound" },
    { "$ref": "#/$defs/cancelPlan" },
    { "$ref": "#/$defs/deletePlan" },
    { "$ref": "#/$defs/editBrief" },
    { "$ref": "#/$defs/note" },
    { "$ref": "#/$defs/retryRoute" }
  ],
  "$defs": {
    "base": {
      "type": "object",
      "required": ["type", "idempotencyKey", "target", "precondition"],
      "properties": {
        "type": { "type": "string" },
        "idempotencyKey": { "type": "string", "minLength": 16, "maxLength": 128, "pattern": "^[A-Za-z0-9._~-]+$" },
        "target": {
          "type": "object",
          "required": ["project", "req"],
          "properties": {
            "project": { "type": "string", "minLength": 1, "maxLength": 100 },
            "req": { "type": "string", "pattern": "^REQ-[0-9]{3,}$" },
            "task": { "type": "string", "minLength": 1, "maxLength": 100 },
            "attempt": { "type": "string", "minLength": 1, "maxLength": 100 },
            "round": { "type": "string", "minLength": 1, "maxLength": 100 }
          },
          "additionalProperties": false
        },
        "precondition": {
          "type": "object",
          "required": ["state"],
          "properties": {
            "state": { "type": "string", "minLength": 1, "maxLength": 80 },
            "revision": { "type": "integer", "minimum": 1 },
            "attempt": { "type": "string", "minLength": 1, "maxLength": 100 },
            "updatedAt": { "type": "string", "format": "date-time" }
          },
          "additionalProperties": false
        },
        "reason": { "type": "string", "maxLength": 2000 }
      }
    },
    "confirmation": {
      "type": "object",
      "required": ["challengeId", "typedReq"],
      "properties": {
        "challengeId": { "type": "string", "minLength": 16, "maxLength": 128 },
        "typedReq": { "type": "string", "pattern": "^REQ-[0-9]{3,}$" }
      },
      "additionalProperties": false
    },
    "pause": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        { "properties": { "type": { "const": "pause" } }, "required": ["type"] }
      ],
      "unevaluatedProperties": false
    },
    "resume": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        { "properties": { "type": { "const": "resume" } }, "required": ["type"] }
      ],
      "unevaluatedProperties": false
    },
    "cancelAttempt": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "properties": {
            "type": { "const": "cancel-attempt" },
            "target": { "required": ["attempt"] }
          },
          "required": ["type"]
        }
      ],
      "unevaluatedProperties": false
    },
    "reopen": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        { "properties": { "type": { "const": "reopen" }, "target": { "required": ["task"] } }, "required": ["type"] }
      ],
      "unevaluatedProperties": false
    },
    "retry": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        { "properties": { "type": { "const": "retry" }, "target": { "required": ["task"] } }, "required": ["type"] }
      ],
      "unevaluatedProperties": false
    },
    "retryRoute": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["route"],
          "properties": {
            "type": { "const": "retry-route" },
            "target": { "required": ["task"] },
            "route": { "type": "string", "minLength": 1, "maxLength": 300 }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "revise": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        { "$ref": "#/$defs/requiresConfirmation" },
        { "properties": { "type": { "const": "revise" } }, "required": ["type"] }
      ],
      "unevaluatedProperties": false
    },
    "approve": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        { "$ref": "#/$defs/requiresConfirmation" },
        { "properties": { "type": { "const": "approve" } }, "required": ["type"] }
      ],
      "unevaluatedProperties": false
    },
    "launch": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        { "$ref": "#/$defs/requiresConfirmation" },
        { "properties": { "type": { "const": "launch" } }, "required": ["type"] }
      ],
      "unevaluatedProperties": false
    },
    "cancelPlan": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        { "$ref": "#/$defs/requiresConfirmation" },
        { "properties": { "type": { "const": "cancel-plan" } }, "required": ["type"] }
      ],
      "unevaluatedProperties": false
    },
    "deletePlan": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        { "$ref": "#/$defs/requiresConfirmation" },
        { "properties": { "type": { "const": "delete-plan" } }, "required": ["type"] }
      ],
      "unevaluatedProperties": false
    },
    "editBrief": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        { "$ref": "#/$defs/requiresConfirmation" },
        {
          "type": "object",
          "required": ["changes"],
          "properties": {
            "type": { "const": "edit-brief" },
            "target": { "required": ["task"] },
            "changes": {
              "type": "object",
              "minProperties": 1,
              "properties": {
                "objective": { "type": "string", "minLength": 1, "maxLength": 10000 },
                "acceptanceCriteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "maxLength": 2000 } }
              },
              "additionalProperties": false
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "answerRound": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["answers"],
          "properties": {
            "type": { "const": "answer-round" },
            "target": { "required": ["round"] },
            "answers": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "object" } }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "note": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["text"],
          "properties": {
            "type": { "const": "note" },
            "target": { "required": ["task"] },
            "text": { "type": "string", "minLength": 1, "maxLength": 4000 }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "requiresConfirmation": {
      "type": "object",
      "required": ["confirmation"],
      "properties": { "confirmation": { "$ref": "#/$defs/confirmation" } }
    }
  }
}
