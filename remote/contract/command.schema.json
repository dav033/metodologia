{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flow-remote.invalid/contract/v1/command.schema.json",
  "title": "Bitácora remote RemoteCommand v1",
  "$defs": {
    "AnswerDecisionCommand": {
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1,
          "type": "integer"
        },
        "idempotencyKey": {
          "maxLength": 120,
          "minLength": 16,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "type": "string"
        },
        "precondition": {
          "$ref": "#/$defs/Precondition"
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "type": {
          "const": "answer-decision",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/RunTarget"
        },
        "requestId": {
          "minLength": 1,
          "type": "string"
        },
        "option": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "schemaVersion",
        "idempotencyKey",
        "precondition",
        "type",
        "target",
        "requestId",
        "option"
      ],
      "type": "object"
    },
    "AnswerRoundCommand": {
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1,
          "type": "integer"
        },
        "idempotencyKey": {
          "maxLength": 120,
          "minLength": 16,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "type": "string"
        },
        "precondition": {
          "$ref": "#/$defs/Precondition"
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "type": {
          "const": "answer-round",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/RoundTarget"
        },
        "round": {
          "minimum": 1,
          "type": "integer"
        },
        "answers": {
          "additionalProperties": true,
          "maxProperties": 50,
          "minProperties": 1,
          "type": "object"
        }
      },
      "required": [
        "schemaVersion",
        "idempotencyKey",
        "precondition",
        "type",
        "target",
        "round",
        "answers"
      ],
      "type": "object"
    },
    "ApproveCommand": {
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1,
          "type": "integer"
        },
        "idempotencyKey": {
          "maxLength": 120,
          "minLength": 16,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "type": "string"
        },
        "precondition": {
          "$ref": "#/$defs/Precondition"
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 2000,
