          "default": null
        },
        "confirmation": {
          "$ref": "#/$defs/Confirmation"
        },
        "type": {
          "const": "approve",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/PlanTarget"
        }
      },
      "required": [
        "schemaVersion",
        "idempotencyKey",
        "precondition",
        "confirmation",
        "type",
        "target"
      ],
      "type": "object"
    },
    "AttemptTarget": {
      "additionalProperties": false,
      "properties": {
        "project": {
          "maxLength": 80,
          "minLength": 1,
          "type": "string"
        },
        "req": {
          "pattern": "^REQ-[0-9]{3,}$",
          "type": "string"
        },
        "kind": {
          "const": "attempt",
          "type": "string"
        },
        "attemptId": {
          "maxLength": 120,
          "minLength": 1,
          "type": "string"
        },
        "taskId": {
          "anyOf": [
            {
              "maxLength": 120,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "project",
        "req",
        "kind",
        "attemptId"
      ],
      "type": "object"
    },
    "CancelAttemptCommand": {
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1,
