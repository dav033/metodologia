# Copy to /etc/bitacora-gateway/gateway.env (mode 0600, owner root). Fill every key; never commit values.
# The host gateway address for the existing Docker-hosted Caddy network is 172.20.0.1.
# Caddy reaches this service at 172.20.0.1:8790, so keep GATEWAY_BIND set to that host interface.
# Required
LAPTOP_ORIGIN=
FLOW_GATEWAY_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
GATEWAY_DATABASE=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SESSION_SECRET=
FLOW_FRONTEND_ORIGIN=
GATEWAY_BIND=
# Optional overrides
GATEWAY_PORT=
UPSTREAM_TIMEOUT=
PROBE_INTERVAL=
GITHUB_AUTHORIZE_URL=
GITHUB_TOKEN_URL=
GITHUB_USER_URL=
