# Copy to /etc/bitacora-gateway/gateway.env (mode 0600, owner root). Fill every uncommented key; never commit values.
# Required
LAPTOP_ORIGIN=
FLOW_GATEWAY_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
GATEWAY_DATABASE=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SESSION_SECRET=
GATEWAY_BIND=
# Public frontend origin (https://<name>.vercel.app). GitHub's callback is <this value>/api/auth/callback, not the API host.
FLOW_FRONTEND_ORIGIN=
# Optional: uncomment only to override the default. An empty value is invalid.
# GATEWAY_PORT=
# UPSTREAM_TIMEOUT=
# PROBE_INTERVAL=
# GITHUB_AUTHORIZE_URL=
# GITHUB_TOKEN_URL=
# GITHUB_USER_URL=
