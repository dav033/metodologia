[Unit]
Description=Bitacora remote control gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bitacora
Group=bitacora
WorkingDirectory=/opt/bitacora/remote/gateway
EnvironmentFile=/etc/bitacora/gateway.env
Environment=GATEWAY_BIND=172.20.0.1
Environment=GATEWAY_PORT=8790
ExecStart=/usr/bin/python3 /opt/bitacora/remote/gateway/main.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/bitacora

[Install]
WantedBy=multi-user.target
