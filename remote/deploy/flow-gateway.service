[Unit]
Description=Flow remote gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=flow
Group=flow
EnvironmentFile=/etc/flow-gateway/env
Environment=FLOW_RUN_BOT=0
WorkingDirectory=/opt/flow-gateway/current/gateway
ExecStart=/usr/bin/python3 /opt/flow-gateway/current/gateway/main.py
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/flow-gateway
StateDirectory=flow-gateway
StateDirectoryMode=0700
UMask=0077

[Install]
WantedBy=multi-user.target
