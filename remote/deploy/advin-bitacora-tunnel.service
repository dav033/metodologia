[Unit]
Description=Reverse SSH tunnel for the Bitacora remote API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/ssh -NT -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -R 127.0.0.1:18765:127.0.0.1:8766 advin
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
