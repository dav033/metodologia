{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "m6.verify-result/1.1",
  "title": "M6 verification result",
  "type": "object",
  "$defs": {
    "verification": {
      "title": "M1 VerifyOrder verification item",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value", "purpose"],
      "properties": {
        "type": {"enum": ["command", "manual"]},
        "value": {"type": "string", "minLength": 1, "maxLength": 4096},
        "purpose": {"type": "string", "minLength": 1, "maxLength": 4096},
        "expected": {"type": "string", "minLength": 1, "maxLength": 4096},
        "created_by": {"type": "string", "maxLength": 256},
        "category": {"enum": ["static", "functional", "integration", "regression", "product"]},
        "environment": {"enum": ["sandbox", "external_authorized", "production", "human_attestation"]},
        "requires": {
          "type": "array", "maxItems": 64, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^(?:[A-Z][A-Z0-9_]{1,63}|service:[a-z0-9][a-z0-9-]{0,63})$"}
        },
        "authorization_needed": {"type": "string", "minLength": 1, "maxLength": 4096}
      },
      "allOf": [
        {"if": {"properties": {"type": {"const": "manual"}}, "required": ["type"]},
         "then": {"required": ["expected"]}},
        {"if": {"properties": {"environment": {"const": "production"}}, "required": ["environment"]},
         "then": {"required": ["authorization_needed"]}},
        {"if": {"properties": {"environment": {"const": "human_attestation"}}, "required": ["environment"]},
         "then": {"properties": {"type": {"const": "manual"}}, "required": ["type", "expected"]}}
      ]
    }
  },
  "additionalProperties": false,
  "required": ["schema_version", "identity", "input", "verifier", "criteria", "checks", "status", "reason_code", "evidence_manifest", "finished_at"],
  "properties": {
    "schema_version": {"const": "m6.verify-result/1.1"},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan_id", "revision", "task_id", "attempt_id", "token"],
      "properties": {
        "plan_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "revision": {"type": "integer", "minimum": 1},
        "task_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "attempt_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "token": {"type": "integer", "minimum": 1}
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "dependentRequired": {
        "composition_id": ["manifest_sha256"],
        "manifest_sha256": ["composition_id"]
      },
      "required": ["snapshot_sha", "base_sha", "criteria_hash", "order_sha256", "checks_sha256", "tree_digest", "contract_identities", "environment_fingerprint"],
      "properties": {
        "snapshot_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40,64}$"},
        "base_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40,64}$"},
        "criteria_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "order_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "checks_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "tree_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40,64}$"},
        "contract_identities": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
        "environment_fingerprint": {"type": ["string", "null"], "pattern": "^[0-9a-f]{24,64}$"},
        "composition_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "identity", "independent", "policy_version"],
      "properties": {
        "kind": {"enum": ["deterministic", "human"]},
        "identity": {"type": "string", "minLength": 1, "maxLength": 256},
        "independent": {"type": "boolean"},
        "policy_version": {"type": "string", "minLength": 1, "maxLength": 64}
      }
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion", "status", "evidence"],
        "properties": {
          "criterion": {"type": "string", "minLength": 1, "maxLength": 4096},
          "status": {"enum": ["pass", "fail", "unknown"]},
          "evidence": {"type": "array", "items": {"type": "string", "maxLength": 256}}
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "command", "argv", "status", "exit_code", "duration_ms", "issue_code", "reason_code", "tree_digest", "stdout_ref", "stderr_ref"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 64},
          "command": {"type": "string", "minLength": 1, "maxLength": 4096},
          "argv": {"type": "array", "items": {"type": "string", "maxLength": 4096}},
          "status": {"enum": ["pass", "fail", "unknown"]},
          "exit_code": {"type": ["integer", "null"]},
          "duration_ms": {"type": "integer", "minimum": 0},
          "issue_code": {"type": ["string", "null"], "pattern": "^[A-Z][A-Z0-9_]{0,63}$"},
          "reason_code": {"enum": ["PASS", "FAIL_CODE", "BLOCKED_EXTERNAL", "BLOCKED_ENV", "TIMEOUT", "FLAKY_SUSPECTED", "NOT_RUN"]},
          "tree_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40,64}$"},
          "stdout_ref": {"type": "string", "pattern": "^m6://artifact/[a-f0-9]{64}$"},
          "stderr_ref": {"type": "string", "pattern": "^m6://artifact/[a-f0-9]{64}$"}
        }
      }
    },
    "status": {"enum": ["PASS", "FAIL", "NEEDS_REVIEW", "STALE"]},
    "reason_code": {"enum": ["PASS", "FAIL_CODE", "BLOCKED_EXTERNAL", "BLOCKED_ENV", "TIMEOUT", "FLAKY_SUSPECTED", "NOT_RUN"]},
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "detail"],
        "properties": {
          "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$"},
          "detail": {"type": "string", "maxLength": 512}
        }
      }
    },
    "evidence_manifest": {"type": "string", "pattern": "^m6://result/[a-f0-9]{64}$"},
    "finished_at": {"type": "string", "format": "date-time"}
  }
}
