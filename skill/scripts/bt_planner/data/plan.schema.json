{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bitacora/plan.schema.json",
  "title": "Planner contract PLAN.json",
  "description": "Structured work plan published by the planner for a deterministic scheduler. Classification fields are mandatory and never defaulted; from schema 1.1.0 every classification is also argued in classification_evidence. Schema 1.2.0 adds requirement coverage, task kind, interface contracts and verification categories. Schema 1.3.0 adds optional functional subplans, composition gates, UI contracts and verification environments. Cross-field rules (unique ids, existing references, acyclic after, milestone order, traceability, interfaces, evidence strength, unordered tasks that share a path, PLAN.md agreement) are enforced by the validator of this package (contract.validate / sync.check) and are not expressible here.",
  "type": "object",
  "required": ["schema_version", "plan_id", "revision", "spec_ref", "milestones", "tasks"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$"},
    "plan_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1, "maximum": 1000000},
    "spec_ref": {"type": "string", "minLength": 1, "description": "relative path inside the requirement folder"},
    "generated_paths": {"type": "array", "maxItems": 256, "items": {"type": "string", "minLength": 1, "maxLength": 1024,
      "description": "Repository-relative tracked output path or fnmatch glob; no absolute paths, dot components, backslashes, colons or control characters"}},
    "generated_command": {"oneOf": [
      {"type": "string", "minLength": 1, "maxLength": 4096},
      {"type": "object", "minProperties": 1, "maxProperties": 256,
       "propertyNames": {"pattern": "^[A-Za-z0-9._-]{1,128}$"},
       "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 4096}}
    ], "description": "Rebuild command for the plan or a map from repository role to command; metadata only, not automatically executed"},
    "milestones": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/milestone"}},
    "tasks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/task"}},
    "requirements": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/requirement_id"}},
    "interfaces": {"type": "array", "items": {"$ref": "#/$defs/interface"}},
    "subplans": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/subplan"}},
    "composition_gates": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/composition_gate"}},
    "stage": {"description": "D-134: this revision is a stage, the projection of the draft onto these subplans (absent: the whole plan). Schema 1.3.0.", "type": "object", "additionalProperties": false, "required": ["version", "subplans"], "properties": {"version": {"const": 1}, "subplans": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^SP-[1-9][0-9]*$"}}}}
  },
  "allOf": [
    {"if": {"properties": {"schema_version": {"pattern": "^1\\.([1-9][0-9]*)\\."}}, "required": ["schema_version"]},
     "then": {"properties": {"tasks": {"items": {"required": ["classification_evidence"]}}}}},
    {"if": {"properties": {"schema_version": {"pattern": "^1\\.([2-9]|[1-9][0-9]+)\\."}}, "required": ["schema_version"]},
     "then": {
       "required": ["requirements"],
       "properties": {
         "tasks": {"items": {"required": ["covers", "kind"],
                               "properties": {"verification": {"items": {"required": ["category"]}}}}}
       }
     }},
    {"if": {"properties": {"schema_version": {"pattern": "^1\\.(?:0|1|2)\\."}}, "required": ["schema_version"]},
     "then": {"properties": {"tasks": {"items": {"properties": {"kind": {"enum": ["implement", "test", "docs", "audit", "research"]}}}}}}
    }
  ],
  "$defs": {
    "text": {"type": "string", "pattern": "\\S"},
    "texts": {"type": "array", "items": {"$ref": "#/$defs/text"}},
    "requirement_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9]{0,7}-?[0-9]{1,4}$"},
    "level": {"enum": ["low", "medium", "high"]},
    "dimension_evidence": {
      "type": "object",
      "required": ["justification", "evidence"],
      "properties": {
        "justification": {"$ref": "#/$defs/text", "description": "why this value and not the neighbouring one; at least 4 words, never a placeholder"},
        "evidence": {"type": "array", "minItems": 1,
                     "items": {"type": "string", "pattern": "^(file|command|precedent|spec|task|assumption):\\S"},
                     "description": "kind:value references; assumption: is allowed but never counts as support"}
      }
    },
    "classification_evidence": {
      "type": "object",
      "required": ["complexity", "scope", "duration", "risk", "coupling", "confidence"],
      "properties": {
        "complexity": {"$ref": "#/$defs/dimension_evidence"}, "scope": {"$ref": "#/$defs/dimension_evidence"},
        "duration": {"$ref": "#/$defs/dimension_evidence"}, "risk": {"$ref": "#/$defs/dimension_evidence"},
        "coupling": {"$ref": "#/$defs/dimension_evidence"}, "confidence": {"$ref": "#/$defs/dimension_evidence"}
      },
      "additionalProperties": false
    },
    "milestone": {
      "type": "object",
      "required": ["id", "title", "acceptance_criteria"],
      "properties": {
        "id": {"type": "string", "pattern": "^M[0-9]+$"},
        "title": {"$ref": "#/$defs/text"},
        "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}}
      }
    },
    "verification": {
      "type": "object",
      "required": ["type", "value", "purpose"],
      "properties": {
        "type": {"enum": ["command", "manual"]},
        "value": {"$ref": "#/$defs/text"},
        "purpose": {"$ref": "#/$defs/text"},
        "expected": {"$ref": "#/$defs/text", "description": "required when type is manual"},
        "created_by": {"type": "string", "pattern": "^T[0-9]+(\\.[0-9]+)?[a-z]?$", "description": "task that creates a test that does not exist yet"},
        "category": {"enum": ["static", "functional", "integration", "regression", "product"],
                     "description": "what this verification demonstrates, independent of command/manual execution type"},
        "environment": {"enum": ["sandbox", "external_authorized", "production", "human_attestation"]},
        "requires": {"type": "array", "items": {"type": "string", "pattern": "^(?:[A-Z][A-Z0-9_]{1,63}|service:[a-z0-9][a-z0-9-]{0,63})$"}},
        "authorization_needed": {"$ref": "#/$defs/text"}
      }
    },
    "task": {
      "type": "object",
      "required": ["id", "milestone_id", "title", "objective", "repository", "after", "complexity", "scope",
                   "estimated_minutes", "risk", "coupling", "confidence", "estimate_rationale", "expected_paths",
                   "shared_resources", "acceptance_criteria", "verification"],
      "properties": {
        "id": {"type": "string", "pattern": "^T[0-9]+(\\.[0-9]+)?[a-z]?$"},
        "milestone_id": {"type": "string", "pattern": "^M[0-9]+$"},
        "title": {"$ref": "#/$defs/text"},
        "objective": {"$ref": "#/$defs/text"},
        "repository": {"$ref": "#/$defs/text"},
        "after": {"type": "array", "items": {"type": "string", "pattern": "^T[0-9]+(\\.[0-9]+)?[a-z]?$"}},
        "complexity": {"enum": ["low", "medium", "high", "extreme"]},
        "scope": {"enum": ["isolated_fix", "small_change", "large_change", "full_feature", "full_system"]},
        "estimated_minutes": {"type": "integer", "minimum": 1, "maximum": 100000},
        "risk": {"$ref": "#/$defs/level"},
        "coupling": {"$ref": "#/$defs/level"},
        "confidence": {"$ref": "#/$defs/level"},
        "estimate_rationale": {"$ref": "#/$defs/text"},
        "classification_evidence": {"$ref": "#/$defs/classification_evidence"},
        "expected_paths": {"$ref": "#/$defs/texts"},
        "shared_resources": {"$ref": "#/$defs/texts"},
        "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
        "verification": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/verification"}},
        "covers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/requirement_id"}},
        "kind": {"enum": ["implement", "test", "docs", "audit", "research", "design"],
                 "description": "model-agnostic kind from the Scheduler-supported vocabulary"},
        "subplan_id": {"type": "string", "pattern": "^SP-[1-9][0-9]*$"},
        "ui": {"type": "boolean"},
        "scope_exception": {"type": "object", "required": ["reason"], "properties": {"reason": {"$ref": "#/$defs/text"}},
                            "description": "only with scope=full_system, for explicit review"}
      },
      "not": {"anyOf": [{"required": ["model"]}, {"required": ["agent"]}, {"required": ["account"]},
                        {"required": ["workers"]}, {"required": ["status"]}, {"required": ["attempts"]}]}
    },
    "subplan": {
      "type": "object", "required": ["id", "milestone_id", "title", "outcome", "covers", "acceptance_criteria", "integration_test_task", "audit_task"],
      "properties": {
        "id": {"type": "string", "pattern": "^SP-[1-9][0-9]*$"}, "milestone_id": {"type": "string", "pattern": "^M[0-9]+$"},
        "title": {"$ref": "#/$defs/text"}, "outcome": {"$ref": "#/$defs/text"},
        "covers": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/requirement_id"}},
        "acceptance_criteria": {"$ref": "#/$defs/texts"},
        "produces": {"type": "array", "items": {"$ref": "#/$defs/produced_contract"}},
        "consumes": {"type": "array", "items": {"$ref": "#/$defs/consumed_contract"}},
        "checkpoints": {"type": "array", "items": {"type": "object", "required": ["task", "purpose"], "properties": {"task": {"type": "string"}, "purpose": {"$ref": "#/$defs/text"}}}},
        "integration_test_task": {"type": "string"}, "audit_task": {"type": "string"}, "ui": {"$ref": "#/$defs/ui_contract"},
        "ui_brief": {"$ref": "#/$defs/ui_brief"}
      }
    },
    "produced_contract": {"type": "object", "required": ["contract", "version", "defined_by"], "properties": {"contract": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"}, "version": {"type": "integer", "minimum": 1, "maximum": 1000}, "defined_by": {"type": "string"}, "interfaces": {"type": "array", "items": {"type": "string", "pattern": "^IF-[1-9][0-9]*$"}}}},
    "consumed_contract": {"type": "object", "required": ["contract", "version", "from", "dependency"], "properties": {"contract": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"}, "version": {"type": "integer", "minimum": 1, "maximum": 1000}, "from": {"type": "string", "pattern": "^(?:SP-[1-9][0-9]*|external)$"}, "dependency": {"enum": ["contract", "implementation", "publication"]}, "verified_by": {"type": "array", "items": {"type": "string"}}}},
    "ui_contract": {"type": "object", "required": ["contract", "version", "design_task", "visual_review_task"], "properties": {"contract": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"}, "version": {"type": "integer", "minimum": 1, "maximum": 1000}, "design_task": {"type": "string"}, "visual_review_task": {"type": "string"}}},
    "ui_brief": {"description": "Optional Planner hand-off to the Designer for a UI subplan; it wins over the UI brief derived from the subplan. Schema 1.3.0.", "type": "object", "additionalProperties": false, "properties": {"flows": {"type": "array", "items": {"anyOf": [{"$ref": "#/$defs/text"}, {"type": "object", "additionalProperties": false, "required": ["name", "steps"], "properties": {"name": {"$ref": "#/$defs/text"}, "steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}}}}]}}, "screens_states": {"type": "array", "items": {"$ref": "#/$defs/text"}}, "existing_surface": {"type": "object", "additionalProperties": false, "properties": {"routes": {"type": "array", "items": {"$ref": "#/$defs/text"}}, "paths": {"type": "array", "items": {"$ref": "#/$defs/text"}}, "components": {"type": "array", "items": {"$ref": "#/$defs/text"}}, "screenshots": {"type": "array", "items": {"$ref": "#/$defs/text"}}, "notes": {"type": "string"}}}, "must_not_change": {"type": "array", "items": {"$ref": "#/$defs/text"}}, "copy_rules": {"type": "array", "items": {"$ref": "#/$defs/text"}}, "criteria": {"type": "array", "items": {"$ref": "#/$defs/text"}}}},
    "composition_gate": {"type": "object", "required": ["id", "subplans", "task", "criteria"], "properties": {"id": {"type": "string", "pattern": "^CG-[1-9][0-9]*$"}, "subplans": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^SP-[1-9][0-9]*$"}}, "task": {"type": "string"}, "audit_task": {"type": "string"}, "criteria": {"$ref": "#/$defs/texts"}}},
    "interface": {
      "type": "object",
      "required": ["id", "title", "owner", "producer_task", "consumer_tasks", "inputs", "outputs", "invariants",
                   "integration_criteria"],
      "properties": {
        "id": {"type": "string", "pattern": "^IF-[1-9][0-9]*$"},
        "title": {"$ref": "#/$defs/text"},
        "owner": {"$ref": "#/$defs/text"},
        "producer_task": {"type": "string", "pattern": "^T[0-9]+(\\.[0-9]+)?[a-z]?$"},
        "consumer_tasks": {"type": "array", "minItems": 1,
                           "items": {"type": "string", "pattern": "^T[0-9]+(\\.[0-9]+)?[a-z]?$"}},
        "integration_task": {"type": "string", "pattern": "^T[0-9]+(\\.[0-9]+)?[a-z]?$"},
        "inputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
        "outputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
        "invariants": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
        "integration_criteria": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}}
      }
    }
  }
}
