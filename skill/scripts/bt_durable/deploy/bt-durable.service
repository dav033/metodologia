# The durable runtime's engine (REQ-030): DBOS executor, recovery on start, orphan reaper.
# Install: ~/.config/systemd/user/bt-durable.service, then `systemctl --user enable --now bt-durable`.
[Unit]
Description=Metodologia durable runtime engine (bt_durable)
After=default.target

[Service]
Type=simple
WorkingDirectory=%h/dev/metodologia
# BT_DURABLE_DATABASE_URL (PostgreSQL); absent = SQLite under the state folder
EnvironmentFile=-%h/.config/bitacora/durable.env
ExecStart=%h/.local/bin/uv run --project %h/dev/metodologia bt-durable engine
Restart=always
RestartSec=5
# the engine exits within seconds of SIGTERM (service.serve); this bounds a maintenance pass still running.
# Agents live in their own units and survive an engine stop.
TimeoutStopSec=60
KillMode=mixed
# Background work (D-250): the engine's M6 verifications (next build, tsc, test suites) run in this cgroup. Under
# contention the desktop gets the CPU first; idle cores still go to the checks. Attempt units carry the same values.
Nice=15
CPUWeight=20
IOWeight=20

[Install]
WantedBy=default.target
