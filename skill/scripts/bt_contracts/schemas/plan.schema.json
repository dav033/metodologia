        },
        "interfaces": {
          "items": {
            "$ref": "#/$defs/Interface"
          },
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "plan_id",
        "revision",
        "spec_ref",
        "milestones",
        "tasks",
        "requirements"
      ],
      "type": "object"
    },
