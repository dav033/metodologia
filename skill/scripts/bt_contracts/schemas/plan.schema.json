{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bitacora.invalid/contract/plan.schema.json",
  "title": "Bitácora PLAN.json, schema 1.0.0 / 1.1.0 / 1.2.0 / 1.3.0",
  "description": "Generated from the Pydantic models of bt_contracts/plan.py; do not edit. Rules across objects (unique ids, references that resolve, an acyclic `after`, consumed contracts produced by the subplan they name, a stage listing the revision's subplans, text that is not blank, relative paths) are enforced by the models' validators and are not all expressible here. Text and evidence quality, coverage totality, task roles and ordering remain the planner's authoring rules.",
  "$defs": {
    "Checkpoint": {
      "additionalProperties": false,
      "properties": {
        "task": {
          "pattern": "\\S",
          "type": "string"
        },
        "purpose": {
          "pattern": "\\S",
          "type": "string"
        }
      },
      "required": [
        "task",
        "purpose"
      ],
      "type": "object"
    },
    "ClassificationEvidence": {
      "additionalProperties": false,
      "description": "Every classification argued per dimension (schema 1.1.0 and later).",
      "properties": {
        "complexity": {
          "$ref": "#/$defs/DimensionEvidence"
        },
        "scope": {
          "$ref": "#/$defs/DimensionEvidence"
        },
        "duration": {
          "$ref": "#/$defs/DimensionEvidence"
        },
        "risk": {
          "$ref": "#/$defs/DimensionEvidence"
        },
        "coupling": {
          "$ref": "#/$defs/DimensionEvidence"
        },
        "confidence": {
          "$ref": "#/$defs/DimensionEvidence"
        }
      },
      "required": [
        "complexity",
        "scope",
        "duration",
        "risk",
        "coupling",
        "confidence"
      ],
      "type": "object"
    },
    "CompositionGate": {
      "additionalProperties": false,
      "description": "Subplans whose published versions are composed and tested together before dependent work continues.",
      "properties": {
        "id": {
          "pattern": "^CG-[1-9][0-9]*$",
          "type": "string"
        },
        "subplans": {
          "items": {
            "pattern": "^SP-[1-9][0-9]*$",
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "task": {
          "pattern": "\\S",
          "type": "string"
        },
        "audit_task": {
          "anyOf": [
            {
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "criteria": {
          "items": {
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "id",
        "subplans",
        "task",
        "criteria"
      ],
      "type": "object"
    },
    "ConsumedContract": {
      "additionalProperties": false,
      "properties": {
        "contract": {
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
          "type": "string"
        },
        "version": {
          "maximum": 1000,
          "minimum": 1,
          "type": "integer"
        },
        "from": {
          "pattern": "^(?:SP-[1-9][0-9]*|external)$",
          "type": "string"
        },
        "dependency": {
          "enum": [
            "contract",
            "implementation",
            "publication"
          ],
          "type": "string"
        },
        "verified_by": {
          "items": {
            "pattern": "\\S",
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "contract",
        "version",
        "from",
        "dependency"
      ],
      "type": "object"
    },
    "DimensionEvidence": {
      "additionalProperties": false,
      "properties": {
        "justification": {
          "pattern": "\\S",
          "type": "string"
        },
        "evidence": {
          "items": {
            "description": "kind:value, kind in file, command, precedent, spec, task, assumption",
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "justification",
        "evidence"
      ],
      "type": "object"
    },
    "ExistingSurface": {
      "additionalProperties": false,
      "properties": {
        "routes": {
          "items": {
            "pattern": "\\S",
            "type": "string"
          },
          "type": "array"
        },
        "paths": {
          "items": {
            "pattern": "\\S",
            "type": "string"
          },
          "type": "array"
        },
        "components": {
          "items": {
            "pattern": "\\S",
            "type": "string"
          },
          "type": "array"
        },
        "screenshots": {
          "items": {
            "pattern": "\\S",
            "type": "string"
          },
          "type": "array"
        },
        "notes": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "Interface": {
      "additionalProperties": false,
      "description": "A cross-task interface (schema 1.2.0): who produces it, who consumes it, what must hold.",
      "properties": {
        "id": {
          "pattern": "^IF-[1-9][0-9]*$",
          "type": "string"
        },
        "title": {
          "pattern": "\\S",
          "type": "string"
        },
        "owner": {
          "pattern": "\\S",
          "type": "string"
        },
        "producer_task": {
          "pattern": "\\S",
          "type": "string"
        },
        "consumer_tasks": {
          "items": {
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "integration_task": {
          "pattern": "\\S",
          "type": "string"
        },
        "inputs": {
          "items": {
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "outputs": {
          "items": {
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "invariants": {
          "items": {
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "integration_criteria": {
          "items": {
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "id",
        "title",
        "owner",
        "producer_task",
        "consumer_tasks",
        "inputs",
        "outputs",
        "invariants",
        "integration_criteria"
      ],
      "type": "object"
    },
    "Milestone": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^M[0-9]+$",
          "type": "string"
        },
        "title": {
          "pattern": "\\S",
          "type": "string"
        },
        "acceptance_criteria": {
          "items": {
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "id",
        "title",
        "acceptance_criteria"
      ],
      "type": "object"
    },
    "Plan100": {
      "additionalProperties": false,
      "description": "A frozen PLAN.json revision, schema 1.0.0: milestones and classified tasks.",
      "properties": {
        "schema_version": {
          "const": "1.0.0",
          "type": "string"
        },
        "plan_id": {
          "pattern": "\\S",
          "type": "string"
        },
        "revision": {
          "maximum": 1000000,
          "minimum": 1,
          "type": "integer"
        },
        "spec_ref": {
          "pattern": "\\S",
          "type": "string"
        },
        "milestones": {
          "items": {
            "$ref": "#/$defs/Milestone"
          },
          "minItems": 1,
          "type": "array"
        },
        "tasks": {
          "items": {
            "$ref": "#/$defs/Task100"
          },
          "maxItems": 10000,
          "minItems": 1,
          "type": "array"
        },
        "generated_paths": {
          "items": {
            "maxLength": 1024,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 256,
          "type": "array"
        },
        "generated_command": {
          "anyOf": [
            {
              "maxLength": 4096,
              "type": "string"
            },
            {
              "maxProperties": 256,
              "minProperties": 1,
              "patternProperties": {
                "^[A-Za-z0-9._-]{1,128}$": {
                  "maxLength": 4096,
                  "type": "string"
                }
              },
              "type": "object"
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "plan_id",
        "revision",
        "spec_ref",
        "milestones",
        "tasks"
      ],
      "type": "object"
    },
    "Plan110": {
      "additionalProperties": false,
      "description": "Schema 1.1.0: every classification is argued in classification_evidence.",
      "properties": {
        "schema_version": {
          "const": "1.1.0",
          "type": "string"
        },
        "plan_id": {
          "pattern": "\\S",
          "type": "string"
        },
        "revision": {
          "maximum": 1000000,
          "minimum": 1,
          "type": "integer"
        },
        "spec_ref": {
          "pattern": "\\S",
          "type": "string"
        },
        "milestones": {
          "items": {
            "$ref": "#/$defs/Milestone"
          },
          "minItems": 1,
          "type": "array"
        },
        "tasks": {
          "items": {
            "$ref": "#/$defs/Task110"
