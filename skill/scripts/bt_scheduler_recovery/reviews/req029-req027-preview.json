 "diagnosis_invoked": false,
 "digest": "f54b9612bfd897e1c0ea4e49d035c729e374be85282774539a07281a65e6a853",
 "labels": {
  "07245a54e5c4ad971bbfe33de06ba83dff77285f800743c43c707e5503be67d6:F1": "Caddy used container loopback instead of the host Docker bridge upstream.",
  "07245a54e5c4ad971bbfe33de06ba83dff77285f800743c43c707e5503be67d6:F10": "Ordinary plans waiting for approval previously emitted no plan.waiting event without a scheduler decision.",
  "07245a54e5c4ad971bbfe33de06ba83dff77285f800743c43c707e5503be67d6:F11": "Gateway restart loses the last cached snapshot and restarts SSE IDs without a reset/resynchronization protocol.",
  "07245a54e5c4ad971bbfe33de06ba83dff77285f800743c43c707e5503be67d6:F12": "Gateway event replay memory, delivered/dropped outbox history and abandoned expired sessions remain unbounded.",
  "07245a54e5c4ad971bbfe33de06ba83dff77285f800743c43c707e5503be67d6:F13": "The stable cachedAt repair remains, but no stable offline-start timestamp reaches the phone.",
  "07245a54e5c4ad971bbfe33de06ba83dff77285f800743c43c707e5503be67d6:F14": "Laptop-side redaction previously missed provider-key assignments and bearer authorization text before transmission.",
  "07245a54e5c4ad971bbfe33de06ba83dff77285f800743c43c707e5503be67d6:F15": "The local panel previously had no inherited systemd listener implementation.",
  "07245a54e5c4ad971bbfe33de06ba83dff77285f800743c43c707e5503be67d6:F16": "The phone still discards unknown-outcome command envelopes and creates a fresh idempotency key on resubmission.",
  "07245a54e5c4ad971bbfe33de06ba83dff77285f800743c43c707e5503be67d6:F17": "The public command schema still disagrees with production commands and key limits; event target normalization has been repaired.",
  "07245a54e5c4ad971bbfe33de06ba83dff77285f800743c43c707e5503be67d6:F18": "The required browser verification previously failed and asserted obsolete singular round answers.",
  "07245a54e5c4ad971bbfe33de06ba83dff77285f800743c43c707e5503be67d6:F19": "The integrated phone app previously failed strict typing and production build due to overlapping implementations.",
  "07245a54e5c4ad971bbfe33de06ba83dff77285f800743c43c707e5503be67d6:F2": "The required built-web E2E still fails: its forced-failure fixture produces no failure event or notification.",
  "07245a54e5c4ad971bbfe33de06ba83dff77285f800743c43c707e5503be67d6:F20": "The phone previously rejected the real gateway's successful {login:'dav033'} session response.",
  "07245a54e5c4ad971bbfe33de06ba83dff77285f800743c43c707e5503be67d6:F21": "The phone still opens an SSE route the production gateway does not serve and does not resume using its replay IDs.",
  "07245a54e5c4ad971bbfe33de06ba83dff77285f800743c43c707e5503be67d6:F22": "The earlier env-startup allegation assumed blank optional settings despite the current runbook requiring every uncommented key to be filled.",
  "07245a54e5c4ad971bbfe33de06ba83dff77285f800743c43c707e5503be67d6:F23": "Overlapping phone command-history implementations previously broke compilation and mislabeled origin.",
  "07245a54e5c4ad971bbfe33de06ba83dff77285f800743c43c707e5503be67d6:F24": "Installed planning-command preconditions previously failed because bt_remote_preconditions was absent from distributions.",
  "07245a54e5c4ad971bbfe33de06ba83dff77285f800743c43c707e5503be67d6:F25": "The failed-task link previously opened only an unrelated static review fixture.",
  "07245a54e5c4ad971bbfe33de06ba83dff77285f800743c43c707e5503be67d6:F26": "Rejected failure review is now reachable, but authoritative rejected tasks still cannot be recovered from the phone.",
  "07245a54e5c4ad971bbfe33de06ba83dff77285f800743c43c707e5503be67d6:F27": "Command rate limits remain shared by owner login across sessions rather than per session as R17 specifies.",
  "07245a54e5c4ad971bbfe33de06ba83dff77285f800743c43c707e5503be67d6:F28": "The command ledger checks preconditions before its effect lock and accepts a second concurrently stale command.",
  "07245a54e5c4ad971bbfe33de06ba83dff77285f800743c43c707e5503be67d6:F29": "Production snapshots omit the timestamp fields the phone uses for last signal of life and discard plan detail/revision metadata.",
  "07245a54e5c4ad971bbfe33de06ba83dff77285f800743c43c707e5503be67d6:F30": "Stalled-attempt notifications start after 15 minutes although the specification requires more than 10 minutes.",
  "07245a54e5c4ad971bbfe33de06ba83dff77285f800743c43c707e5503be67d6:F31": "An already authenticated SSE connection continues to deliver after the session expires.",
  "07245a54e5c4ad971bbfe33de06ba83dff77285f800743c43c707e5503be67d6:F32": "Every phone pinned-retry command is rejected because the gateway forwards a route object to a laptop validator requiring string selectors.",
  "07245a54e5c4ad971bbfe33de06ba83dff77285f800743c43c707e5503be67d6:F4": "Gateway request logging exposes OAuth code/state query values in its purported status field.",
  "07245a54e5c4ad971bbfe33de06ba83dff77285f800743c43c707e5503be67d6:F5": "The mutation marker accepts arbitrary nonempty values, and GET logout clears the cookie without guards or revoking its server session.",
  "07245a54e5c4ad971bbfe33de06ba83dff77285f800743c43c707e5503be67d6:F6": "Telegram alerts still omit a working review URL and safe inline actions, and retry callbacks remain unsupported.",
  "07245a54e5c4ad971bbfe33de06ba83dff77285f800743c43c707e5503be67d6:F7": "The public note command is still advertised and validated without a laptop dispatcher.",
  "07245a54e5c4ad971bbfe33de06ba83dff77285f800743c43c707e5503be67d6:F8": "The phone brief form still cannot edit acceptance criteria.",
  "07245a54e5c4ad971bbfe33de06ba83dff77285f800743c43c707e5503be67d6:F9": "Run-level Reabrir ejecuci\u00f3n supplies no task identity to a task-scoped operation.",
  "717955fab53677f34780a1d4841af7f38c1074ed6673097479b66b7865c0a610:F1": "The prior Caddy container-loopback upstream defect is corrected in the supplied prerequisite tree.",
  "717955fab53677f34780a1d4841af7f38c1074ed6673097479b66b7865c0a610:F10": "An ordinary plan waiting for approval still emits no plan.waiting event without a scheduler decision.",
  "717955fab53677f34780a1d4841af7f38c1074ed6673097479b66b7865c0a610:F11": "Restart still loses the cached snapshot and resets SSE IDs without a resynchronization protocol.",
  "717955fab53677f34780a1d4841af7f38c1074ed6673097479b66b7865c0a610:F12": "Gateway event history, delivered/dropped outbox/history and abandoned expired sessions remain unbounded.",
  "717955fab53677f34780a1d4841af7f38c1074ed6673097479b66b7865c0a610:F13": "Failed probes relabel cached data with the current time; offline start time is not exposed to the phone.",
  "717955fab53677f34780a1d4841af7f38c1074ed6673097479b66b7865c0a610:F14": "Laptop redaction still misses provider API-key assignments and bearer authorization text before transmission.",
  "717955fab53677f34780a1d4841af7f38c1074ed6673097479b66b7865c0a610:F16": "The web still discards unknown-outcome envelopes and generates a fresh key on every retry.",
  "717955fab53677f34780a1d4841af7f38c1074ed6673097479b66b7865c0a610:F17": "Published command/event schemas still disagree with production dialects, field names and key limits.",
  "717955fab53677f34780a1d4841af7f38c1074ed6673097479b66b7865c0a610:F18": "Browser checks still share Next.js output/configuration, and serial execution now reveals a stale answer-round contract assertion.",
  "717955fab53677f34780a1d4841af7f38c1074ed6673097479b66b7865c0a610:F19": "The current run-history parser does not typecheck, preventing the production build and every built-web E2E scenario.",
  "717955fab53677f34780a1d4841af7f38c1074ed6673097479b66b7865c0a610:F20": "Successful real OAuth sessions cannot load the phone panel because the gateway and web disagree on the session response.",
  "717955fab53677f34780a1d4841af7f38c1074ed6673097479b66b7865c0a610:F21": "The real phone feed cannot connect or decode production events despite mock SSE coverage.",
  "717955fab53677f34780a1d4841af7f38c1074ed6673097479b66b7865c0a610:F22": "Filling the required env-example values still leaves blank optional settings that prevent gateway startup.",
  "717955fab53677f34780a1d4841af7f38c1074ed6673097479b66b7865c0a610:F23": "Phone command history drops the stored web/telegram origin and displays target/command in its place.",
  "717955fab53677f34780a1d4841af7f38c1074ed6673097479b66b7865c0a610:F3": "Runbook still omits installing/configuring the private laptop API and reverse tunnel; public Caddy hostname remains an unexplained placeholder.",
  "717955fab53677f34780a1d4841af7f38c1074ed6673097479b66b7865c0a610:F4": "Request logging still writes OAuth code/state query values into the status field.",
  "717955fab53677f34780a1d4841af7f38c1074ed6673097479b66b7865c0a610:F5": "GET logout bypasses mutation guards, and the CSRF marker accepts any nonempty value rather than 1.",
  "717955fab53677f34780a1d4841af7f38c1074ed6673097479b66b7865c0a610:F6": "Telegram retry and alert action/deep-link integration are missing; the previous bad retry envelope was removed rather than repaired.",
  "717955fab53677f34780a1d4841af7f38c1074ed6673097479b66b7865c0a610:F9": "Run-level Reabrir ejecuci\u00f3n still sends no task to a dispatcher that requires one."
 },
