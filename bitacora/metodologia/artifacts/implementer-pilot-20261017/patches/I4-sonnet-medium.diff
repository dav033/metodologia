+import sqlite3
+from contextlib import closing
+
+SCHEMA_VERSION = 1
+
+_CREATE_SQL = (
+    "CREATE TABLE {name}(id INTEGER PRIMARY KEY, value TEXT NOT NULL, "
+    "normalized TEXT NOT NULL)"
+)
+
+
+def _normalize(value):
+    return str(value).strip().lower()
+
+
+def _has_items(conn):
+    row = conn.execute(
+        "SELECT 1 FROM sqlite_master WHERE type='table' AND name='items'"
+    ).fetchone()
+    return row is not None
+
+
+def _convert_legacy(conn, fault):
+    conn.execute("DROP TABLE IF EXISTS items_new")
+    conn.execute(_CREATE_SQL.format(name="items_new"))
+    rows = conn.execute("SELECT id, value FROM items ORDER BY id").fetchall()
+    conn.executemany(
+        "INSERT INTO items_new(id, value, normalized) VALUES (?, ?, ?)",
+        [(i, v, _normalize(v)) for i, v in rows],
+    )
+    if fault:
+        fault("after_copy")
+    conn.execute("DROP TABLE items")
+    conn.execute("ALTER TABLE items_new RENAME TO items")
+
+
 def migrate(path, fault=None):
-    pass
+    """Migrate the DB at path to user_version 1 in a single transaction."""
+    conn = sqlite3.connect(path, isolation_level=None)
+    try:
+        conn.execute("BEGIN IMMEDIATE")
+        try:
+            version = conn.execute("PRAGMA user_version").fetchone()[0]
+            if version > SCHEMA_VERSION:
+                raise ValueError(f"unsupported schema version: {version}")
+            if version == SCHEMA_VERSION:
+                conn.execute("ROLLBACK")
+                return
+            if _has_items(conn):
+                _convert_legacy(conn, fault)
+            else:
+                conn.execute(_CREATE_SQL.format(name="items"))
+            conn.execute(f"PRAGMA user_version = {SCHEMA_VERSION}")
+            if fault:
+                fault("before_commit")
+            conn.execute("COMMIT")
+        except BaseException:
+            if conn.in_transaction:
+                conn.execute("ROLLBACK")
+            raise
+    finally:
+        conn.close()
+
 
 def read_items(path):
-    return []
+    """Return [(id, normalized)] ordered by id from a migrated DB."""
+    uri = "file:" + path.replace("?", "%3f").replace("#", "%23") + "?mode=ro"
+    with closing(sqlite3.connect(uri, uri=True)) as conn:
+        version = conn.execute("PRAGMA user_version").fetchone()[0]
+        if version != SCHEMA_VERSION:
+            raise ValueError(f"database not migrated (version {version})")
+        return [
+            (i, n)
+            for i, n in conn.execute(
+                "SELECT id, normalized FROM items ORDER BY id"
+            )
+        ]
--- before/app/test_store.py
+++ after/app/test_store.py
@@ -0,0 +1,45 @@
+import os, sqlite3, tempfile, unittest
+from app.store import migrate, read_items
+
+
+def legacy(p, rows):
+    c = sqlite3.connect(p)
+    c.execute("CREATE TABLE items(id INTEGER PRIMARY KEY, value TEXT NOT NULL)")
+    c.executemany("INSERT INTO items VALUES(?,?)", rows)
+    c.commit(); c.close()
+
+
+class T(unittest.TestCase):
+    def setUp(self):
+        self.d = tempfile.TemporaryDirectory(); self.p = os.path.join(self.d.name, "db")
+    def tearDown(self): self.d.cleanup()
+
+    def test_legacy(self):
+        legacy(self.p, [(5, " AbC "), (-2, "X")])
+        migrate(self.p)
+        self.assertEqual(read_items(self.p), [(-2, "x"), (5, "abc")])
+        calls = []
+        migrate(self.p, calls.append); self.assertEqual(calls, [])
+
+    def test_faults(self):
+        legacy(self.p, [(1, " A")])
+        for pt in ("after_copy", "before_commit"):
+            def f(n, pt=pt):
+                if n == pt: raise RuntimeError(pt)
+            with self.assertRaises(RuntimeError): migrate(self.p, f)
+            c = sqlite3.connect(self.p)
+            self.assertEqual(c.execute("PRAGMA user_version").fetchone()[0], 0)
+            self.assertEqual([r[0] for r in c.execute("select name from sqlite_master")], ["items"])
+            c.close()
+        migrate(self.p)
+        self.assertEqual(read_items(self.p), [(1, "a")])
+        c = sqlite3.connect(self.p)
+        self.assertEqual([r[0] for r in c.execute("select name from sqlite_master")], ["items"])
+
+    def test_future(self):
+        c = sqlite3.connect(self.p); c.execute("PRAGMA user_version=2"); c.close()
+        with self.assertRaises(ValueError): migrate(self.p)
+        c = sqlite3.connect(self.p)
+        self.assertEqual(c.execute("select count(*) from sqlite_master").fetchone()[0], 0)
+
+if __name__ == "__main__": unittest.main()
