+def _normalize(intervals):
+    """Validate pairs and drop empty ones; raise ValueError on reversed bounds."""
+    pairs = []
+    for start, end in intervals:
+        if end < start:
+            raise ValueError(f"reversed interval: ({start}, {end})")
+        if end > start:
+            pairs.append((start, end))
+    return pairs
