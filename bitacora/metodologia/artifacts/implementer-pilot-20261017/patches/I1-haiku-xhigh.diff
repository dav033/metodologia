 def merge_intervals(intervals):
+    """Return sorted, merged half-open (start, end) intervals as a new list.
+
+    Overlapping and touching intervals are merged. Empty intervals are dropped.
+    A reversed interval (end < start) raises ValueError.
+    """
+    pairs = _validated_nonempty(intervals)
     result = []
-    for start, end in sorted(intervals):
-        if result and start < result[-1][1]:
+    for start, end in sorted(pairs):
+        if result and start <= result[-1][1]:
             result[-1] = (result[-1][0], max(result[-1][1], end))
         else:
             result.append((start, end))
     return result
+
+
+def _validated_nonempty(intervals):
+    """Consume the input once, rejecting reversed bounds and dropping empty intervals."""
+    kept = []
+    for start, end in intervals:
+        if end < start:
+            raise ValueError(f"reversed interval: ({start}, {end})")
+        if start < end:
+            kept.append((start, end))
+    return kept
--- before/app/test_intervals.py
+++ after/app/test_intervals.py
@@ -0,0 +1,94 @@
+import unittest
+
+from app.intervals import merge_intervals
+
+
+class MergeIntervalsTests(unittest.TestCase):
+    def test_empty_input_returns_empty_list(self):
+        self.assertEqual(merge_intervals([]), [])
+
+    def test_single_interval_is_returned_as_tuple(self):
+        self.assertEqual(merge_intervals([(2, 6)]), [(2, 6)])
+
+    def test_overlapping_intervals_are_merged(self):
+        self.assertEqual(merge_intervals([(1, 4), (3, 6)]), [(1, 6)])
+
+    def test_touching_intervals_are_merged(self):
+        self.assertEqual(merge_intervals([(1, 3), (3, 5)]), [(1, 5)])
+
+    def test_disjoint_intervals_are_kept_separate_and_sorted(self):
+        self.assertEqual(merge_intervals([(7, 9), (1, 2)]), [(1, 2), (7, 9)])
+
+    def test_gap_of_one_is_not_merged(self):
+        self.assertEqual(merge_intervals([(1, 3), (4, 6)]), [(1, 3), (4, 6)])
+
+    def test_unsorted_chain_merges_fully(self):
+        self.assertEqual(merge_intervals([(5, 8), (1, 2), (2, 4), (7, 10)]), [(1, 4), (5, 10)])
+
+    def test_nested_interval_keeps_outer_bounds(self):
+        self.assertEqual(merge_intervals([(1, 10), (3, 4)]), [(1, 10)])
+
+    def test_duplicates_collapse(self):
+        self.assertEqual(merge_intervals([(1, 3), (1, 3), (1, 3)]), [(1, 3)])
+
+    def test_empty_intervals_are_dropped(self):
+        self.assertEqual(merge_intervals([(4, 4), (1, 2), (9, 9)]), [(1, 2)])
+
+    def test_empty_interval_does_not_bridge_gap(self):
+        self.assertEqual(merge_intervals([(1, 3), (3, 3), (5, 7)]), [(1, 3), (5, 7)])
+
+    def test_only_empty_intervals_returns_empty_list(self):
+        self.assertEqual(merge_intervals([(2, 2), (-1, -1)]), [])
+
+    def test_negative_coordinates(self):
+        self.assertEqual(merge_intervals([(-5, -2), (-3, 1), (4, 6)]), [(-5, 1), (4, 6)])
+
+    def test_zero_crossing_touching_merge(self):
+        self.assertEqual(merge_intervals([(-2, 0), (0, 2)]), [(-2, 2)])
+
+    def test_generator_input(self):
+        gen = ((s, e) for s, e in [(3, 5), (1, 3)])
+        self.assertEqual(merge_intervals(gen), [(1, 5)])
+
+    def test_iterator_input_from_zip(self):
+        self.assertEqual(merge_intervals(zip([1, 6], [4, 8])), [(1, 4), (6, 8)])
+
+    def test_input_list_is_not_mutated(self):
+        data = [(3, 5), (1, 3), (8, 8)]
+        snapshot = list(data)
+        merge_intervals(data)
+        self.assertEqual(data, snapshot)
+
+    def test_input_tuple_is_accepted(self):
+        self.assertEqual(merge_intervals(((3, 5), (1, 3))), [(1, 5)])
+
+    def test_list_pairs_are_accepted(self):
+        self.assertEqual(merge_intervals([[3, 5], [1, 3]]), [(1, 5)])
+
+    def test_returns_new_list_each_call(self):
+        data = [(1, 2)]
+        first = merge_intervals(data)
+        second = merge_intervals(data)
+        self.assertIsNot(first, second)
+        first.append((9, 9))
+        self.assertEqual(second, [(1, 2)])
+
+    def test_reversed_bounds_raise_value_error(self):
+        with self.assertRaises(ValueError):
+            merge_intervals([(5, 1)])
+
+    def test_reversed_bounds_raise_even_with_empty_intervals_present(self):
+        with self.assertRaises(ValueError):
+            merge_intervals([(2, 2), (5, 1)])
+
+    def test_reversed_bounds_raise_even_with_valid_intervals_present(self):
+        with self.assertRaises(ValueError):
+            merge_intervals([(1, 2), (9, 4), (3, 5)])
+
+    def test_reversed_bounds_raise_from_generator(self):
+        with self.assertRaises(ValueError):
+            merge_intervals((s, e) for s, e in [(1, 2), (4, 3)])
+
+
+if __name__ == "__main__":
+    unittest.main()
