+def enqueue(path, id, payload, depends_on=None):
+    with closing(_connection(path)) as connection:
+        connection.execute(
+            "INSERT OR IGNORE INTO jobs(id, payload, depends_on) VALUES (?, ?, ?)",
+            (id, payload, depends_on),
+        )
+        connection.commit()
