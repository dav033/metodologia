+"""SQLite-backed job storage."""
+
 import sqlite3
+from contextlib import contextmanager
+
+
+_MAX_SQLITE_INTEGER = 2**63 - 1
+
+
+@contextmanager
+def _connection(path):
+    """Open a connection for one operation and always close it."""
+    connection = sqlite3.connect(path, timeout=30.0)
+    try:
+        yield connection
+    finally:
+        connection.close()
+
+
+@contextmanager
+def _transaction(connection, begin="BEGIN"):
+    """Run a transaction, rolling it back if its body or commit fails."""
+    connection.execute(begin)
+    try:
+        yield connection
+        connection.commit()
+    except BaseException:
+        try:
+            connection.rollback()
+        except sqlite3.Error:
+            pass
+        raise
+
 
