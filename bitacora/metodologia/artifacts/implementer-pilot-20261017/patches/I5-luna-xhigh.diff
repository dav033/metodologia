+def enqueue(path, id, payload, depends_on=None):
+    """Insert a job once, retaining the first payload for duplicate ids."""
+    with _connection(path) as connection:
+        with _transaction(connection, "BEGIN IMMEDIATE"):
+            connection.execute(
+                "INSERT OR IGNORE INTO jobs(id, payload, depends_on) VALUES (?, ?, ?)",
+                (id, payload, depends_on),
+            )
+
+
+def claim(path, now, ttl):
+    """Claim the lexicographically first pending or expired job."""
+    if ttl <= 0:
+        raise ValueError("ttl must be positive")
+
+    with _connection(path) as connection:
+        with _transaction(connection, "BEGIN IMMEDIATE"):
+            row = connection.execute(
+                """SELECT id, payload, token, attempts
+                   FROM jobs
+                   WHERE state = 'pending'
+                      OR (state = 'running' AND lease_until <= ?)
+                   ORDER BY id ASC
+                   LIMIT 1""",
+                (now,),
+            ).fetchone()
+            if row is None:
+                return None
+
+            job_id, payload, token, attempts = row
+            if token >= _MAX_SQLITE_INTEGER or attempts >= _MAX_SQLITE_INTEGER:
+                raise OverflowError("job token or attempt count exceeds SQLite INTEGER range")
+
+            next_token = token + 1
+            next_attempts = attempts + 1
+            lease_until = now + ttl
+            changed = connection.execute(
+                """UPDATE jobs
+                   SET state = ?, token = ?, lease_until = ?, attempts = ?
+                   WHERE id = ?""",
+                ("running", next_token, lease_until, next_attempts, job_id),
+            ).rowcount
+            if changed != 1:
+                raise RuntimeError("claimed job changed during an immediate transaction")
+
+            return job_id, payload, next_token
+
+
+def complete(path, id, token, result, now, fault=None):
+    """Complete a live lease if its fencing token still matches."""
+    with _connection(path) as connection:
+        with _transaction(connection, "BEGIN IMMEDIATE"):
+            changed = connection.execute(
+                """UPDATE jobs
+                   SET state = ?, result = ?, lease_until = NULL
+                   WHERE id = ?
+                     AND state = 'running'
+                     AND token = ?
+                     AND lease_until > ?""",
+                ("done", result, id, token, now),
+            ).rowcount
+            return changed == 1
+
+
+def inspect(path, id):
+    """Return every stored column for a job, or None when it is absent."""
+    with _connection(path) as connection:
+        connection.row_factory = sqlite3.Row
+        row = connection.execute("SELECT * FROM jobs WHERE id = ?", (id,)).fetchone()
+        return dict(row) if row is not None else None
+
