+function generoConPolaridad(entrada: EntradaIdeas): { genero: GeneroBebe | null; excluidos: GeneroBebe[] } {
+  if (!esBabyShower(entrada.evento)) return { genero: null, excluidos: [] };
+  const delMensaje = analizarPolaridad(entrada.ultimoUsuario);
+  const delTema = analizarPolaridad(entrada.tematica);
+  const excluidos = generosNombrados([...delMensaje.negativos, ...delTema.negativos].join(" "));
+  const genero = [delMensaje.positivo, delTema.positivo].map(generoBebeDe).find((nombrado) => nombrado !== null && !excluidos.includes(nombrado)) ?? null;
+  return { genero, excluidos };
 }
 
