+}
+
+function textoDe(decoracion: DecoracionSempertex): string {
+  return normalizarBusqueda(`${decoracion.titulo} ${decoracion.tematica}`);
+}
+
+function contiene(texto: string, forma: string): boolean {
+  return ` ${texto} `.includes(` ${forma} `);
+}
