diff --git a/src/components/tres-d/exportadores-escena-globos.ts b/src/components/tres-d/exportadores-escena-globos.ts
new file mode 100644
index 0000000000000000000000000000000000000000..94f9e74c645fae0f7a80f157250d0dc6b2786841
