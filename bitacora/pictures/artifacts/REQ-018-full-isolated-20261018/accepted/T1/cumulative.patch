+
+type JsonBodyResult = { ok: true; value: unknown } | { ok: false; status: 400 | 413 };
+
+async function readJsonBody(request: Request, maximumBytes: number): Promise<JsonBodyResult> {
+  const declaredBytes = Number(request.headers.get("content-length"));
+  if (Number.isFinite(declaredBytes) && declaredBytes > maximumBytes) return { ok: false, status: 413 };
+  let text: string;
+  try {
+    text = await request.text();
+  } catch {
+    return { ok: false, status: 400 };
+  }
+  if (Buffer.byteLength(text, "utf8") > maximumBytes) return { ok: false, status: 413 };
+  try {
+    return { ok: true, value: JSON.parse(text) as unknown };
+  } catch {
+    return { ok: false, status: 400 };
+  }
+}
+
+function emptyNotFound(): Response {
+  return new Response(null, { status: 404, headers: PRIVATE_HEADERS });
+}
+
+function errorJson(status: number, code: string, message: string): Response {
+  return Response.json({ code, message }, { status, headers: PRIVATE_HEADERS });
+}
+
+function hasRequiredOrigin(request: Request, dependencies: SharedQuoteHttpDependencies): boolean {
+  return request.headers.has("origin") && dependencies.sameOrigin(request);
+}
+
+export async function handleCreateSharedQuote(
+  request: Request,
+  dependencies: SharedQuoteHttpDependencies,
+): Promise<Response> {
+  if (!dependencies.authenticate(request)) return errorJson(401, "UNAUTHORIZED", "La sesión no es válida.");
+  if (!hasRequiredOrigin(request, dependencies)) return errorJson(403, "ORIGIN_REJECTED", "La solicitud no es válida.");
+  const body = await readJsonBody(request, MAX_CREATE_BODY_BYTES);
+  if (!body.ok) return errorJson(body.status, body.status === 413 ? "PAYLOAD_TOO_LARGE" : "INVALID_JSON", "No se pudo leer la solicitud.");
+
+  try {
+    const result = await createSharedQuote(dependencies, body.value);
+    return Response.json(result, { headers: PRIVATE_HEADERS });
+  } catch (error) {
+    if (error instanceof ZodError) return errorJson(400, "INVALID_INPUT", "La cotización compartida no tiene un formato válido.");
+    if (error instanceof SharedQuoteStillError) return errorJson(400, "INVALID_STILL", "No se pudo preparar la imagen de la escena.");
+    if (error instanceof SharedQuoteDisabledError) return emptyNotFound();
+    if (error instanceof SharedQuoteConfigurationError) return errorJson(503, "SHARING_UNAVAILABLE", "La cotización compartida no está disponible.");
+    console.error("[shared-quotes] create failed", { requestId: randomUUID() });
+    return errorJson(502, "QUOTE_UNAVAILABLE", "No pude preparar el precio para compartir.");
+  }
+}
+
+export async function handleListOwnerSharedQuotes(
+  request: Request,
+  dependencies: SharedQuoteHttpDependencies,
+): Promise<Response> {
+  if (!dependencies.authenticate(request)) return errorJson(401, "UNAUTHORIZED", "La sesión no es válida.");
+  if (!dependencies.readerEnabled) return emptyNotFound();
+  const sceneKey = new URL(request.url).searchParams.get("sceneKey");
+  if (!sceneKey) return errorJson(400, "INVALID_INPUT", "Falta la escena.");
+  try {
+    const quotes = await listOwnerSharedQuotes(dependencies, sceneKey);
+    return Response.json({ quotes }, { headers: PRIVATE_HEADERS });
+  } catch {
+    console.error("[shared-quotes] owner list failed", { requestId: randomUUID() });
+    return errorJson(503, "SHARING_UNAVAILABLE", "No pude cargar las respuestas.");
+  }
+}
+
+export async function handlePublicSharedQuote(
+  token: string,
+  dependencies: SharedQuoteHttpDependencies,
+): Promise<Response> {
+  try {
+    const quote = await getPublicSharedQuote(dependencies, token);
+    return quote ? Response.json(quote, { headers: PRIVATE_HEADERS }) : emptyNotFound();
+  } catch {
+    console.error("[shared-quotes] public read failed", { requestId: randomUUID() });
+    return errorJson(503, "SHARING_UNAVAILABLE", "La cotización no está disponible.");
+  }
+}
+
+export async function handlePublicSharedStill(
+  token: string,
+  dependencies: SharedQuoteHttpDependencies,
+): Promise<Response> {
+  try {
+    const bytes = await getPublicSharedStill(dependencies, token);
+    if (!bytes) return emptyNotFound();
+    return new Response(Uint8Array.from(bytes), {
+      status: 200,
+      headers: {
+        ...PRIVATE_HEADERS,
+        "Content-Type": "image/jpeg",
+        "Content-Length": String(bytes.length),
+        "Content-Security-Policy": "default-src 'none'; sandbox",
+      },
+    });
+  } catch {
+    console.error("[shared-quotes] public image read failed", { requestId: randomUUID() });
+    return errorJson(503, "SHARING_UNAVAILABLE", "La imagen no está disponible.");
+  }
+}
+
+export async function handlePublicSharedQuoteDecision(
+  request: Request,
+  token: string,
+  dependencies: SharedQuoteHttpDependencies,
+): Promise<Response> {
+  if (!hasRequiredOrigin(request, dependencies)) return errorJson(403, "ORIGIN_REJECTED", "La solicitud no es válida.");
+  const body = await readJsonBody(request, MAX_DECISION_BODY_BYTES);
+  if (!body.ok) return errorJson(body.status, body.status === 413 ? "PAYLOAD_TOO_LARGE" : "INVALID_JSON", "No se pudo leer la respuesta.");
+  try {
+    const result = await recordSharedQuoteDecision(dependencies, token, body.value);
+    if (result.status === "not-found" || result.status === "disabled") return emptyNotFound();
+    if (result.status === "already-answered") return errorJson(409, "ALREADY_ANSWERED", "Esta cotización ya tiene una respuesta.");
+    return Response.json({ status: "saved" }, { headers: PRIVATE_HEADERS });
+  } catch (error) {
+    if (error instanceof ZodError) return errorJson(400, "INVALID_INPUT", "La respuesta no tiene un formato válido.");
+    console.error("[shared-quotes] decision failed", { requestId: randomUUID() });
+    return errorJson(503, "SHARING_UNAVAILABLE", "No pude guardar la respuesta.");
+  }
+}
diff --git a/src/lib/shared-quotes/repository.ts b/src/lib/shared-quotes/repository.ts
new file mode 100644
index 0000000000000000000000000000000000000000..82019914d7c099af0c4229c384073106440fa4df
--- /dev/null
+++ b/src/lib/shared-quotes/repository.ts
@@ -0,0 +1,156 @@
+import "server-only";
+
+import { z } from "zod";
+import type { Pool } from "pg";
+import type { OwnerSharedQuote, SharedQuoteStatus } from "./contracts";
+
+export type NewSharedQuote = {
+  id: string;
+  schemaVersion: 1;
+  sceneName: string;
+  sceneRevisionHash: string;
+  validUntil: string;
+  totalCop: number;
+  stillBytes: Buffer;
+};
+
+export type SharedQuoteRecord = {
+  id: string;
+  schemaVersion: number;
+  sceneName: string;
+  sceneRevisionHash: string;
+  validUntil: string;
+  totalCop: number;
+  status: SharedQuoteStatus;
+  customerName: string | null;
+  comment: string | null;
+  respondedAt: string | null;
+  createdAt: string;
+};
+
+export type SharedQuoteRepository = {
+  insert(record: NewSharedQuote): Promise<void>;
+  findById(id: string): Promise<SharedQuoteRecord | null>;
+  findStillById(id: string): Promise<Buffer | null>;
+  listBySceneRevision(hash: string, limit: number): Promise<OwnerSharedQuote[]>;
+  saveDecision(input: {
+    id: string;
+    validUntil: string;
+    status: Exclude<SharedQuoteStatus, "pending">;
+    customerName: string;
+    comment: string | null;
+  }): Promise<boolean>;
+};
+
+const PgIntegerSchema = z.union([
+  z.number().int().safe(),
+  z.string().regex(/^\d+$/).transform(Number).pipe(z.number().int().safe()),
+]).pipe(z.number().nonnegative());
+
+const SharedQuoteRowSchema = z.object({
+  id: z.string().uuid(),
+  schema_version: z.number().int(),
+  scene_name: z.string().min(1).max(120),
+  scene_revision_hash: z.string().regex(/^[0-9a-f]{64}$/),
+  valid_until: z.string(),
+  total_cop: PgIntegerSchema,
+  status: z.enum(["pending", "approved", "changes_requested"]),
+  customer_name: z.string().max(100).nullable(),
+  customer_comment: z.string().max(2000).nullable(),
+  responded_at: z.date().nullable(),
+  created_at: z.date(),
+}).strict();
+
+function mapRecord(input: unknown): SharedQuoteRecord {
+  const row = SharedQuoteRowSchema.parse(input);
+  return {
+    id: row.id,
+    schemaVersion: row.schema_version,
+    sceneName: row.scene_name,
+    sceneRevisionHash: row.scene_revision_hash,
+    validUntil: row.valid_until,
+    totalCop: row.total_cop,
+    status: row.status,
+    customerName: row.customer_name,
+    comment: row.customer_comment,
+    respondedAt: row.responded_at?.toISOString() ?? null,
+    createdAt: row.created_at.toISOString(),
+  };
+}
+
+const SELECT_COLUMNS = [
+  "id",
+  "schema_version",
+  "scene_name",
+  "scene_revision_hash",
+  "valid_until::text AS valid_until",
+  "total_cop",
+  "status",
+  "customer_name",
+  "customer_comment",
+  "responded_at",
+  "created_at",
+].join(", ");
+
+export function createPostgresSharedQuoteRepository(pool: Pool): SharedQuoteRepository {
+  return {
+    async insert(record) {
+      await pool.query(
+        "INSERT INTO taller_quote_shares " +
+          "(id, schema_version, scene_name, scene_revision_hash, valid_until, currency, total_cop, still_mime_type, still_bytes) " +
+          "VALUES ($1, $2, $3, $4, $5::date, 'COP', $6, 'image/jpeg', $7)",
+        [record.id, record.schemaVersion, record.sceneName, record.sceneRevisionHash, record.validUntil, record.totalCop, record.stillBytes],
+      );
+    },
+    async findById(id) {
+      const result = await pool.query<Record<string, unknown>>(
+        `SELECT ${SELECT_COLUMNS} FROM taller_quote_shares WHERE id = $1`,
+        [id],
+      );
+      return result.rows[0] ? mapRecord(result.rows[0]) : null;
+    },
+    async findStillById(id) {
+      const result = await pool.query<{ still_bytes: unknown }>(
+        "SELECT still_bytes FROM taller_quote_shares WHERE id = $1",
+        [id],
+      );
+      const bytes = result.rows[0]?.still_bytes;
+      if (bytes === undefined || bytes === null) return null;
+      if (!Buffer.isBuffer(bytes)) throw new Error("Invalid persisted quote image.");
+      return bytes;
+    },
+    async listBySceneRevision(hash, limit) {
+      const result = await pool.query<Record<string, unknown>>(
+        `SELECT ${SELECT_COLUMNS} FROM taller_quote_shares
+         WHERE scene_revision_hash = $1
+         ORDER BY created_at DESC
+         LIMIT $2`,
+        [hash, limit],
+      );
+      return result.rows.map((raw) => {
+        const row = mapRecord(raw);
+        return {
+          id: row.id,
+          sceneName: row.sceneName,
+          validUntil: row.validUntil,
+          status: row.status,
+          customerName: row.customerName,
+          comment: row.comment,
+          respondedAt: row.respondedAt,
+          createdAt: row.createdAt,
+        };
+      });
+    },
+    async saveDecision(input) {
+      const result = await pool.query(
+        "UPDATE taller_quote_shares " +
+          "SET status = $3, customer_name = $4, customer_comment = $5, responded_at = now() " +
+          "WHERE id = $1 AND valid_until = $2::date AND status = 'pending' " +
+          "AND valid_until >= (now() AT TIME ZONE 'America/Bogota')::date " +
+          "RETURNING id",
+        [input.id, input.validUntil, input.status, input.customerName, input.comment],
+      );
+      return result.rowCount === 1;
+    },
+  };
+}
diff --git a/src/lib/shared-quotes/service.ts b/src/lib/shared-quotes/service.ts
new file mode 100644
index 0000000000000000000000000000000000000000..4739da1ba76ba2d23ac9b06f1b9eedb49836b1e4
--- /dev/null
+++ b/src/lib/shared-quotes/service.ts
@@ -0,0 +1,183 @@
+import "server-only";
+
+import { createHash, randomUUID } from "node:crypto";
+import { z } from "zod";
+import {
+  CreateSharedQuoteSchema,
+  MAX_SHARED_STILL_BYTES,
+  SharedQuoteDecisionSchema,
+  type OwnerSharedQuote,
+  type PublicSharedQuote,
+  type SharedQuoteDecision,
+} from "./contracts";
+import { isFutureValidUntil, isNotExpired } from "./dates";
+import { signShareToken, verifyShareToken } from "./token";
+import type { NewSharedQuote, SharedQuoteRecord, SharedQuoteRepository } from "./repository";
+import { CotizacionProfesionalResultadoSchema, MAX_COP, type EntradaCotizacionProfesional } from "@/lib/cotizacion/profesional";
+
+const SceneKeySchema = z.string().trim().min(1).max(128);
+const IdSchema = z.string().uuid();
+
+export class SharedQuoteDisabledError extends Error {}
+export class SharedQuoteConfigurationError extends Error {}
+export class SharedQuoteStillError extends Error {}
+
+export type SharedQuoteServiceDependencies = {
+  repository: SharedQuoteRepository;
+  secret: string;
+  readerEnabled: boolean;
+  writerEnabled: boolean;
+  calculateQuote: (input: EntradaCotizacionProfesional) => Promise<unknown>;
+  now?: () => Date;
+  createId?: () => string;
+};
+
+function currentTime(dependencies: SharedQuoteServiceDependencies): Date {
+  return dependencies.now?.() ?? new Date();
+}
+
+function writerIsEnabled(dependencies: SharedQuoteServiceDependencies): boolean {
+  return dependencies.readerEnabled && dependencies.writerEnabled;
+}
+
+function revisionHash(sceneKey: string): string {
+  return createHash("sha256").update(sceneKey, "utf8").digest("hex");
+}
+
+function jpegFromBase64(value: string): Buffer {
+  const bytes = Buffer.from(value, "base64");
+  const isJpeg = bytes.length >= 4 && bytes[0] === 0xff && bytes[1] === 0xd8
+    && bytes[2] === 0xff && bytes[bytes.length - 2] === 0xff && bytes[bytes.length - 1] === 0xd9;
+  if (bytes.toString("base64") !== value || bytes.length > MAX_SHARED_STILL_BYTES || !isJpeg) {
+    throw new SharedQuoteStillError("La imagen de la escena no tiene un JPEG válido.");
+  }
+  return bytes;
+}
+
+function tokenPayloadFor(
+  dependencies: SharedQuoteServiceDependencies,
+  token: string,
+): { id: string; validUntil: string } | null {
+  return verifyShareToken(token, dependencies.secret, currentTime(dependencies));
+}
+
+function recordMatchesToken(
+  record: SharedQuoteRecord | null,
+  payload: { id: string; validUntil: string },
+  now: Date,
+): record is SharedQuoteRecord {
+  return record !== null && record.id === payload.id && record.schemaVersion === 1
+    && record.validUntil === payload.validUntil && isNotExpired(record.validUntil, now);
+}
+
+export async function createSharedQuote(
+  dependencies: SharedQuoteServiceDependencies,
+  unknownInput: unknown,
+): Promise<{ path: string; validUntil: string }> {
+  if (!writerIsEnabled(dependencies)) throw new SharedQuoteDisabledError();
+  if (Buffer.byteLength(dependencies.secret, "utf8") < 32) throw new SharedQuoteConfigurationError();
+
+  const input = CreateSharedQuoteSchema.parse(unknownInput);
+  const now = currentTime(dependencies);
+  if (!isFutureValidUntil(input.validUntil, now)) {
+    throw new z.ZodError([{
+      code: "custom",
+      path: ["validUntil"],
+      message: "La vigencia debe terminar después de hoy en Colombia.",
+    }]);
+  }
+
+  const stillBytes = jpegFromBase64(input.stillBase64);
+  const calculated = CotizacionProfesionalResultadoSchema.parse(await dependencies.calculateQuote(input.quoteInput));
+  if (calculated.precio_sugerido_cop > MAX_COP) {
+    throw new SharedQuoteConfigurationError();
+  }
+
+  const id = (dependencies.createId ?? randomUUID)();
+  IdSchema.parse(id);
+  const record: NewSharedQuote = {
+    id,
+    schemaVersion: 1,
+    sceneName: input.sceneName,
+    sceneRevisionHash: revisionHash(input.sceneKey),
+    validUntil: input.validUntil,
+    totalCop: calculated.precio_sugerido_cop,
+    stillBytes,
+  };
+  const token = signShareToken({ id, validUntil: input.validUntil }, dependencies.secret);
+  await dependencies.repository.insert(record);
+  return { path: `/cotizacion-compartida/${token}`, validUntil: input.validUntil };
+}
+
+export async function getPublicSharedQuote(
+  dependencies: SharedQuoteServiceDependencies,
+  token: string,
+): Promise<PublicSharedQuote | null> {
+  if (!dependencies.readerEnabled) return null;
+  const payload = tokenPayloadFor(dependencies, token);
+  if (!payload) return null;
+  const now = currentTime(dependencies);
+  const record = await dependencies.repository.findById(payload.id);
+  if (!recordMatchesToken(record, payload, now)) return null;
+  return {
+    sceneName: record.sceneName,
+    validUntil: record.validUntil,
+    totalCop: record.totalCop,
+    currency: "COP",
+    status: record.status,
+    createdAt: record.createdAt,
+  };
+}
+
+export async function getPublicSharedStill(
+  dependencies: SharedQuoteServiceDependencies,
+  token: string,
+): Promise<Buffer | null> {
+  if (!dependencies.readerEnabled) return null;
+  const payload = tokenPayloadFor(dependencies, token);
+  if (!payload) return null;
+  const now = currentTime(dependencies);
+  const record = await dependencies.repository.findById(payload.id);
+  if (!recordMatchesToken(record, payload, now)) return null;
+  return dependencies.repository.findStillById(payload.id);
+}
+
+export async function recordSharedQuoteDecision(
+  dependencies: SharedQuoteServiceDependencies,
+  token: string,
+  unknownDecision: unknown,
+): Promise<{ status: "saved" } | { status: "already-answered" } | { status: "not-found" } | { status: "disabled" }> {
+  if (!writerIsEnabled(dependencies)) return { status: "disabled" };
+  const parsedDecision = SharedQuoteDecisionSchema.safeParse(unknownDecision);
+  if (!parsedDecision.success) throw parsedDecision.error;
+  const decision: SharedQuoteDecision = parsedDecision.data;
+  const payload = tokenPayloadFor(dependencies, token);
+  if (!payload) return { status: "not-found" };
+  const now = currentTime(dependencies);
+  const record = await dependencies.repository.findById(payload.id);
+  if (!recordMatchesToken(record, payload, now)) return { status: "not-found" };
+  if (record.status !== "pending") return { status: "already-answered" };
+
+  const saved = await dependencies.repository.saveDecision({
+    id: payload.id,
+    validUntil: payload.validUntil,
+    status: decision.decision,
+    customerName: decision.customerName,
+    comment: decision.comment ?? null,
+  });
+  if (saved) return { status: "saved" };
+
+  const afterRace = await dependencies.repository.findById(payload.id);
+  if (!recordMatchesToken(afterRace, payload, currentTime(dependencies))) return { status: "not-found" };
+  return { status: afterRace.status === "pending" ? "not-found" : "already-answered" };
+}
+
+export async function listOwnerSharedQuotes(
+  dependencies: SharedQuoteServiceDependencies,
+  sceneKey: unknown,
+): Promise<OwnerSharedQuote[]> {
+  if (!dependencies.readerEnabled) return [];
+  const parsedKey = SceneKeySchema.safeParse(sceneKey);
+  if (!parsedKey.success) return [];
+  return dependencies.repository.listBySceneRevision(revisionHash(parsedKey.data), 20);
+}
diff --git a/src/lib/shared-quotes/token.ts b/src/lib/shared-quotes/token.ts
new file mode 100644
index 0000000000000000000000000000000000000000..1858f58ffeeccd6b013f43075d5e8313a0b5f795
--- /dev/null
+++ b/src/lib/shared-quotes/token.ts
@@ -0,0 +1,64 @@
+import "server-only";
+
+import { createHmac, timingSafeEqual } from "node:crypto";
+import { z } from "zod";
+import { ValidUntilSchema } from "./contracts";
+import { isNotExpired } from "./dates";
+
+const TOKEN_SECRET_BYTES_MIN = 32;
+const TOKEN_LENGTH_MAX = 256;
+const PayloadSchema = z.object({
+  v: z.literal(1),
+  id: z.string().uuid(),
+  validUntil: ValidUntilSchema,
+}).strict();
+
+export type ShareTokenPayload = z.infer<typeof PayloadSchema>;
+
+function secretIsStrong(secret: string): boolean {
+  return Buffer.byteLength(secret, "utf8") >= TOKEN_SECRET_BYTES_MIN;
+}
+
+function signatureFor(payload: string, secret: string): Buffer {
+  return createHmac("sha256", secret).update(payload, "utf8").digest();
+}
+
+export function signShareToken(
+  input: { id: string; validUntil: string },
+  secret: string,
+): string {
+  if (!secretIsStrong(secret)) throw new Error("El secreto de enlaces compartidos debe tener al menos 32 bytes.");
+  const payload = PayloadSchema.parse({ v: 1, ...input });
+  const encodedPayload = Buffer.from(JSON.stringify(payload), "utf8").toString("base64url");
+  const signature = signatureFor(encodedPayload, secret).toString("base64url");
+  return `${encodedPayload}.${signature}`;
+}
+
+export function verifyShareToken(
+  token: string,
+  secret: string,
+  now: Date,
+): ShareTokenPayload | null {
+  if (!secretIsStrong(secret) || token.length > TOKEN_LENGTH_MAX) return null;
+  const parts = token.split(".");
+  if (parts.length !== 2 || parts.some((part) => !/^[A-Za-z0-9_-]+$/.test(part))) return null;
+
+  const [encodedPayload, encodedSignature] = parts;
+  const receivedSignature = Buffer.from(encodedSignature, "base64url");
+  if (receivedSignature.toString("base64url") !== encodedSignature) return null;
+  const expectedSignature = signatureFor(encodedPayload, secret);
+  if (receivedSignature.length !== expectedSignature.length || !timingSafeEqual(receivedSignature, expectedSignature)) return null;
+
+  const bytes = Buffer.from(encodedPayload, "base64url");
+  if (bytes.toString("base64url") !== encodedPayload) return null;
+  let decoded: unknown;
+  try {
+    decoded = JSON.parse(bytes.toString("utf8")) as unknown;
+  } catch {
+    return null;
+  }
+
+  const parsed = PayloadSchema.safeParse(decoded);
+  if (!parsed.success || !isNotExpired(parsed.data.validUntil, now)) return null;
+  return parsed.data;
+}
diff --git a/src/lib/taller/cotizacion-profesional-desde-taller.ts b/src/lib/taller/cotizacion-profesional-desde-taller.ts
