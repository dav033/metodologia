--- /dev/null
+++ b/src/lib/biblioteca-sempertex/categorias.ts
@@ -0,0 +1,74 @@
+import { normalizarBusqueda } from "./biblioteca";
+import type { DecoracionSempertex } from "./esquemas";
+
+/**
+ * Categoría = celebración o evento de una decoración (`eventos`). Equivalencia ESTRICTA: solo nombres de una misma
+ * celebración. No son los grupos de afinidad de la búsqueda legacy (`sinonimosEvento`), que acercan bautizo con primera
+ * comunión o cualquier evento con «fiesta infantil». Las etiquetas que no están aquí se descubren de los registros
+ * visibles y valen por sí mismas: una celebración nueva en la biblioteca no necesita editar esta tabla.
+ */
+const CELEBRACIONES: ReadonlyArray<readonly [string, readonly string[]]> = [
+  ["boda", ["boda", "bodas", "matrimonio", "casamiento"]],
+  ["cumpleanos", ["cumpleanos", "cumple"]],
+  ["baby shower", ["baby shower", "babyshower", "bienvenida de bebe"]],
+  ["xv", ["xv", "xv anos", "quince", "quince anos", "quinceanos", "quinceanera", "15 anos"]],
+  ["bautizo", ["bautizo", "bautismo"]],
+  ["comunion", ["comunion", "primera comunion"]],
+  ["san valentin", ["san valentin", "dia de los enamorados", "enamorados"]],
+  ["navidad", ["navidad", "navideno", "navidena", "novena", "novena navidena", "nochebuena"]],
+  ["dia de la madre", ["dia de la madre", "dia de las madres", "dia de la mama", "dia de mama"]],
+  ["halloween", ["halloween", "noche de brujas"]],
+  ["graduacion", ["graduacion", "grado"]],
+];
+
+export type VocabularioCategorias = ReadonlyArray<{ forma: string; clave: string }>;
+export type ClaveCategoria = string;
+
+/** Formas (normalizadas) y su clave: la tabla de alias más las etiquetas de evento de los registros dados. */
+export function vocabularioDeCategorias(catalogo: readonly DecoracionSempertex[]): VocabularioCategorias {
+  const formas = new Map<string, string>();
+  for (const [clave, alias] of CELEBRACIONES) for (const forma of alias) formas.set(forma, clave);
+  for (const decoracion of catalogo) {
+    for (const evento of decoracion.eventos) {
+      const forma = normalizarBusqueda(evento);
+      if (forma && !formas.has(forma)) formas.set(forma, forma);
+    }
+  }
+  return [...formas].map(([forma, clave]) => ({ forma, clave })).sort((a, b) => b.forma.length - a.forma.length);
+}
+
+function contiene(texto: string, forma: string): number {
+  return ` ${texto} `.indexOf(` ${forma} `);
+}
+
+/**
+ * Clave de la categoría que nombra el texto: la etiqueta más larga manda y los tramos ya usados no se reutilizan.
+ * `null` si no nombra ninguna celebración conocida; `"ambigua"` si nombra varias distintas (no se adivina una).
+ */
+export function claveDeCategoria(texto: string, vocabulario: VocabularioCategorias): ClaveCategoria | "ambigua" | null {
+  let resto = ` ${normalizarBusqueda(texto)} `;
+  const claves = new Set<string>();
+  for (const { forma, clave } of vocabulario) {
+    const posicion = resto.indexOf(` ${forma} `);
+    if (posicion < 0) continue;
+    claves.add(clave);
+    resto = resto.slice(0, posicion + 1) + " ".repeat(forma.length) + resto.slice(posicion + 1 + forma.length);
+  }
+  if (claves.size === 0) return null;
+  return claves.size === 1 ? [...claves][0]! : "ambigua";
+}
+
+/** Todas las claves que una etiqueta de evento de un registro nombra («Primer cumpleaños» → él mismo y «cumpleanos»). */
+export function clavesDeEtiqueta(etiqueta: string, vocabulario: VocabularioCategorias): Set<ClaveCategoria> {
+  const texto = normalizarBusqueda(etiqueta);
+  return new Set(vocabulario.filter(({ forma }) => contiene(texto, forma) >= 0).map(({ clave }) => clave));
+}
+
+/** Formas con las que se nombra una categoría: sirven para no tratar «boda» como un estilo pedido. */
+export function formasDeCategoria(clave: ClaveCategoria, vocabulario: VocabularioCategorias): string[] {
+  return vocabulario.filter((entrada) => entrada.clave === clave).map((entrada) => entrada.forma);
+}
+
+export function decoracionEsDeCategoria(decoracion: DecoracionSempertex, clave: ClaveCategoria, vocabulario: VocabularioCategorias): boolean {
+  return decoracion.eventos.some((evento) => clavesDeEtiqueta(evento, vocabulario).has(clave));
+}
diff --git a/src/lib/biblioteca-sempertex/preferencias-texto.ts b/src/lib/biblioteca-sempertex/preferencias-texto.ts
new file mode 100644
index 0000000000000000000000000000000000000000..aa96d70b6deb5060917f30741b40f48a8f6c6f8c
--- /dev/null
+++ b/src/lib/biblioteca-sempertex/preferencias-texto.ts
@@ -0,0 +1,156 @@
+import { ALIAS_COLORES_V2, TONOS_V2 } from "@/lib/rag/taxonomy/v2";
+import { normalizarBusqueda } from "./biblioteca";
+
+/**
+ * Dueño único de dos reglas de la recomendación ESTRICTA (REQ-018, SPEC «Matching and decision contract» 3): la polaridad
+ * de lo que el cliente escribe («sin negro y con dorado») y las formas léxicas de un término de estilo. Funciones puras,
+ * sin dependencia de la búsqueda legacy ni de sus grupos de afinidad. Consumidores: `recomendaciones-categoria.ts` y la
+ * interpretación del género de baby shower en `ia/guiado/ideas-guiadas.ts`.
+ */
+
+export const PALABRAS_GENERO = new Set(["nino", "ninos", "nina", "ninas", "boy", "girl", "varon", "varoncito", "nena", "neutro", "neutra", "neutros", "neutral", "unisex"]);
+export const ANUNCIOS_DE_ESTILO = new Set(["estilo", "estilos", "tematica", "tematicas", "tema", "temas", "motivo", "motivos"]);
+/** «algo elegante», «tipo gótico», «una decoración elegante»: introducen un calificativo pedido aunque el cliente no diga «estilo». */
+export const CALIFICATIVOS_DE_PEDIDO = new Set([
+  "algo", "tipo", "decoracion", "decoraciones", "idea", "ideas", "diseno", "disenos", "opcion", "opciones",
+]);
+/** Intensificadores y valoraciones sin contenido de estilo («algo muy bonito»): nunca son un estilo pedido. */
+export const PALABRAS_GENERICAS = new Set([
+  "muy", "mas", "menos", "bien", "bastante", "super", "tan", "mucho", "mucha", "muchos", "muchas", "poco", "poca", "como", "asi",
+  "bonito", "bonita", "bonitos", "bonitas", "lindo", "linda", "lindos", "lindas", "hermoso", "hermosa", "hermosos", "hermosas", "bello", "bella",
+  "bellos", "bellas", "bueno", "buena", "buenos", "buenas", "genial", "chevere", "especial", "diferente", "distinto", "distinta", "original",
+  "nuevo", "nueva", "similar", "parecido", "parecida", "otro", "otra", "otros", "otras", "mejor", "ideal", "perfecto", "perfecta",
+  // Describen que la idea ya existe en la biblioteca («algo ya armado»), no un estilo.
+  "ya", "armado", "armada", "armados", "armadas", "hecho", "hecha", "hechos", "hechas", "disponible", "disponibles", "listo", "lista",
+  "listos", "listas", "completo", "completa", "completos", "completas", "terminado", "terminada", "existente", "existentes",
+]);
+export const MODIFICADORES_EXCLUSIVIDAD = ["solo", "solamente", "unicamente", "exclusivamente"];
+export const PALABRAS_RELLENO = new Set([
+  "y", "e", "o", "u", "de", "del", "la", "las", "el", "los", "en", "con", "para", "por", "un", "una", "unos", "unas", "mi", "mis", "su", "tu",
+  "que", "a", "al", "se", "lo", "me", "es", "quiero", "quisiera", "gustaria", "algo", "tipo", "estilo", "tono", "tonos", "color", "colores",
+  "fiesta", "decoracion", "decoraciones", "globos", "idea", "ideas", "ano", "anos", "lleve", "lleven", "usar", "uses", "tenga", "tengan",
+  // Cada introductor gramatical de un pedido se descarta igual en cláusulas positivas y negativas: un solo vocabulario.
+  ...ANUNCIOS_DE_ESTILO, ...CALIFICATIVOS_DE_PEDIDO, ...MODIFICADORES_EXCLUSIVIDAD,
+]);
+
+const normalizados = (formas: Iterable<string>): string[] => [...new Set([...formas].map(normalizarBusqueda).filter(Boolean))].sort((a, b) => b.length - a.length);
+export const ALIAS_TONOS = normalizados(Object.values(TONOS_V2).flatMap((tono) => tono.aliases));
+export const ALIAS_COLORES = normalizados(ALIAS_COLORES_V2.flatMap((color) => color.aliases));
+
+const PALABRAS_DE_CORTE = /[.;,!?¿¡\n]/;
+const MARCADORES_NEGATIVOS = [["sin"], ["nada", "de"], ["evita"], ["evitar"], ["excepto"], ["menos"], ["ni"], ["no", "quiero"], ["no", "quieres"], ["no", "me", "gusta"], ["no", "me", "gustan"], ["no", "lleve"], ["no", "uses"], ["no", "usar"], ["no", "con"]];
+const MARCADORES_POSITIVOS = [["con"], ["pero"], ["aunque"], ["si"], ["quiero"], ["quisiera"], ["me", "gusta"], ["me", "gustan"], ["me", "gustaria"], ["gustaria"]];
+/** «no» solo niega lo que le sigue si lo que le sigue es un color, un tono o un género («no negro», «no niña»). */
+const NEGABLES = [...ALIAS_TONOS, ...ALIAS_COLORES, ...PALABRAS_GENERO].map((forma) => forma.split(" "));
+const MARCADORES = [
+  ...MARCADORES_NEGATIVOS.map((palabras) => ({ palabras, negativo: true })),
+  ...MARCADORES_POSITIVOS.map((palabras) => ({ palabras, negativo: false })),
+].sort((a, b) => b.palabras.length - a.palabras.length);
+
+function empiezaCon(palabras: readonly string[], posicion: number, forma: readonly string[]): boolean {
+  return forma.every((palabra, desplazamiento) => palabras[posicion + desplazamiento] === palabra);
+}
+
+function marcadorEn(palabras: readonly string[], posicion: number): { largo: number; negativo: boolean } | null {
+  const marcador = MARCADORES.find((candidato) => empiezaCon(palabras, posicion, candidato.palabras));
+  if (marcador) return { largo: marcador.palabras.length, negativo: marcador.negativo };
+  if (palabras[posicion] === "no" && NEGABLES.some((forma) => empiezaCon(palabras, posicion + 1, forma))) return { largo: 1, negativo: true };
+  return null;
+}
+
+export type TextoConPolaridad = {
+  /** Lo que el cliente pide: el texto sin las cláusulas negadas ni los marcadores de polaridad. */
+  positivo: string;
+  /** Términos que el cliente descarta, uno por elemento, sin relleno («sin negro ni rosa» → negro, rosa). */
+  negativos: string[];
+};
+
+/**
+ * Separa lo pedido de lo descartado, cláusula a cláusula. Cada marcador fija la polaridad de lo que le sigue hasta el
+ * siguiente marcador o fin de oración: «sin negro y con dorado» descarta negro y pide dorado; «no quiero negro
+ * pero sí dorado» igual; «sin flores y sin gótico» descarta ambos. Los marcadores nunca quedan como términos literales.
+ * Las comas separan elementos de una enumeración sin cambiar su polaridad.
+ */
+export function analizarPolaridad(texto: string | undefined): TextoConPolaridad {
+  const positivos: string[] = [];
+  const negativos: string[] = [];
+  let negativo = false;
+  for (const clausula of (texto ?? "").split(/([.;,!?¿¡\n])/)) {
+    if (clausula.length === 1 && PALABRAS_DE_CORTE.test(clausula)) {
+      if (clausula !== ",") negativo = false;
+      continue;
+    }
+    const palabras = normalizarBusqueda(clausula).split(" ").filter(Boolean);
+    let termino: string[] = [];
+    const cerrar = (): void => { if (termino.length) negativos.push(termino.join(" ")); termino = []; };
+    for (let posicion = 0; posicion < palabras.length;) {
+      const marcador = marcadorEn(palabras, posicion);
+      if (marcador) { cerrar(); negativo = marcador.negativo; posicion += marcador.largo; continue; }
+      const palabra = palabras[posicion]!;
+      posicion += 1;
+      if (!negativo) { positivos.push(palabra); continue; }
+      if (["y", "e", "o", "u"].includes(palabra)) cerrar();
+      else if (!PALABRAS_RELLENO.has(palabra) && (!PALABRAS_GENERICAS.has(palabra) || empiezaFraseLexica(palabras, posicion - 1))) termino.push(palabra);
+    }
+    cerrar();
+  }
+  return { positivo: positivos.join(" "), negativos };
+}
+
+/** Grupos de formas de UNA misma palabra o expresión (variantes de escritura y de número), nunca de afinidad semántica. */
+const VARIANTES_LEXICAS: ReadonlyArray<readonly string[]> = [
+  ["dinosaurio", "dinosaurios", "dino", "dinos"],
+  ["unicornio", "unicornios"],
+  ["arcoiris", "arco iris"],
+  ["princesa", "princesas"],
+  ["superheroe", "superheroes", "super heroe", "super heroes"],
+  ["flor", "flores", "floral", "florales"],
+  ["navidad", "navideno", "navidena", "navidenos", "navidenas"],
+  ["hawaiano", "hawaiana", "hawaianos", "hawaianas", "hawai"],
+];
+
+const LARGO_MINIMO = 3;
+
+function conNumeroYGenero(forma: string): string[] {
+  const formas = [forma, `${forma}s`, `${forma}es`];
+  if (forma.endsWith("es") && forma.length - 2 >= LARGO_MINIMO) formas.push(forma.slice(0, -2));
+  if (forma.endsWith("s") && forma.length - 1 >= LARGO_MINIMO) formas.push(forma.slice(0, -1));
+  // El cambio -o/-a es género gramatical («romántico»/«romántica»), pero «niño» y «niña» son géneros distintos, no variantes.
+  if (!PALABRAS_GENERO.has(forma) && forma.length > LARGO_MINIMO) {
+    if (forma.endsWith("o")) formas.push(`${forma.slice(0, -1)}a`, `${forma.slice(0, -1)}as`);
+    if (forma.endsWith("a")) formas.push(`${forma.slice(0, -1)}o`, `${forma.slice(0, -1)}os`);
+  }
+  return formas;
+}
+
+/**
+ * Formas léxicas de un término de estilo, motivo o exclusión: él mismo, su número y género gramatical, y las variantes
+ * de escritura conocidas («dino» → dinosaurio, dinos…). «elegante» no es «negro y dorado», «unicornio» no es «arcoíris»
+ * y «tulipanes» no es «margaritas»: eso es afinidad, no equivalencia. Vacío si el término no tiene palabras.
+ */
+export function formasLexicasEstrictas(termino: string): string[] {
+  const consulta = normalizarBusqueda(termino);
+  if (!consulta) return [];
+  const base = new Set(conNumeroYGenero(consulta));
+  for (const grupo of VARIANTES_LEXICAS) if (grupo.some((forma) => base.has(forma))) grupo.forEach((forma) => base.add(forma));
+  return [...base];
+}
+
+const FRASES_LEXICAS = [...new Set(VARIANTES_LEXICAS.flat().filter((forma) => forma.includes(" ")))].sort((a, b) => b.length - a.length);
+
+/** Una palabra genérica («super») que abre una expresión léxica («super heroes») es parte de ella, no un intensificador. */
+export function empiezaFraseLexica(palabras: readonly string[], posicion: number): boolean {
+  return FRASES_LEXICAS.some((frase) => empiezaCon(palabras, posicion, frase.split(" ")));
+}
+
+/** Saca de un texto normalizado las expresiones léxicas de varias palabras («arco iris») para no partirlas en estilos sueltos. */
+export function separarFrasesLexicas(texto: string): { frases: string[]; resto: string } {
+  const frases: string[] = [];
+  let resto = ` ${texto} `;
+  for (const frase of FRASES_LEXICAS) {
+    if (!resto.includes(` ${frase} `)) continue;
+    frases.push(frase);
+    resto = resto.replace(` ${frase} `, "  ");
+  }
+  return { frases, resto: resto.replace(/\s+/g, " ").trim() };
+}
