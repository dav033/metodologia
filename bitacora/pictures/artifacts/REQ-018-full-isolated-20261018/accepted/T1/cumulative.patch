diff --git a/src/components/shared-quotes/CustomerSharedQuote.tsx b/src/components/shared-quotes/CustomerSharedQuote.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..a64206ef74864baf43089f93df4835ebfd3df18c
--- /dev/null
+++ b/src/components/shared-quotes/CustomerSharedQuote.tsx
@@ -0,0 +1,156 @@
+"use client";
+
+import { useState, type FormEvent } from "react";
+import Image from "next/image";
+import { z } from "zod";
+import type { PublicSharedQuote, SharedQuoteStatus } from "@/lib/shared-quotes/contracts";
+
+const DecisionResponseSchema = z.object({ status: z.literal("saved") }).strict();
+const PublicResponseSchema = z.object({
+  sceneName: z.string(),
+  validUntil: z.string(),
+  totalCop: z.number().int().nonnegative(),
+  currency: z.literal("COP"),
+  status: z.enum(["pending", "approved", "changes_requested"]),
+  createdAt: z.string(),
+}).strict();
+
+const currency = new Intl.NumberFormat("es-CO", { style: "currency", currency: "COP", maximumFractionDigits: 0 });
+const date = new Intl.DateTimeFormat("es-CO", { dateStyle: "long", timeZone: "America/Bogota" });
+function formatValidUntil(value: string): string {
+  return date.format(new Date(value + "T12:00:00-05:00"));
+}
+
+const STATUS_LABEL: Record<SharedQuoteStatus, string> = {
+  pending: "Pendiente de respuesta",
+  approved: "Aprobada",
+  changes_requested: "Solicitud de cambios recibida",
+};
+
+export function CustomerSharedQuote({
+  token,
+  quote,
+  canRespond,
+}: {
+  token: string;
+  quote: PublicSharedQuote;
+  canRespond: boolean;
+}) {
+  const [status, setStatus] = useState(quote.status);
+  const [name, setName] = useState("");
+  const [comment, setComment] = useState("");
+  const [decision, setDecision] = useState<"approved" | "changes_requested">("approved");
+  const [submitting, setSubmitting] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  const [expired, setExpired] = useState(false);
+
+  async function submit(event: FormEvent<HTMLFormElement>) {
+    event.preventDefault();
+    if (submitting || status !== "pending") return;
+    setSubmitting(true);
+    setError(null);
+    const input = {
+      decision,
+      customerName: name,
+      ...(decision === "changes_requested" ? { comment } : {}),
+    };
+    try {
+      const response = await fetch("/api/cotizacion-compartida/" + encodeURIComponent(token) + "/decision", {
+        method: "POST",
+        headers: { "Content-Type": "application/json" },
+        credentials: "same-origin",
+        body: JSON.stringify(input),
+      });
+      if (response.status === 404) {
+        setExpired(true);
+        return;
+      }
+      if (response.status === 409) {
+        await refreshStatus();
+        setError("Esta cotización ya tiene una respuesta.");
+        return;
+      }
+      const body: unknown = await response.json().catch(() => null);
+      if (!response.ok) {
+        const parsedError = z.object({ message: z.string().optional() }).safeParse(body);
+        throw new Error(parsedError.success && parsedError.data.message ? parsedError.data.message : "No pude guardar la respuesta.");
+      }
+      DecisionResponseSchema.parse(body);
+      setStatus(decision);
+    } catch (cause: unknown) {
+      setError(cause instanceof Error ? cause.message : "No pude guardar la respuesta.");
+    } finally {
+      setSubmitting(false);
+    }
+  }
+
+  async function refreshStatus() {
+    const response = await fetch("/api/cotizacion-compartida/" + encodeURIComponent(token), { cache: "no-store" });
+    if (response.status === 404) {
+      setExpired(true);
+      return;
+    }
+    if (!response.ok) return;
+    const current = PublicResponseSchema.parse(await response.json());
+    setStatus(current.status);
+  }
+
+  if (expired) {
+    return <main className="mx-auto max-w-xl p-6 text-center text-texto"><h1 className="text-2xl font-semibold">Este enlace venció o ya no está disponible.</h1></main>;
+  }
+
+  return (
+    <main className="mx-auto flex min-h-screen max-w-3xl flex-col gap-5 px-4 py-8 text-texto sm:px-6">
+      <header>
+        <p className="text-sm font-semibold uppercase tracking-wide text-acento">Cotización de decoración</p>
+        <h1 className="mt-2 text-2xl font-semibold">{quote.sceneName}</h1>
+      </header>
+      <div className="relative h-[60vh] max-h-[600px] w-full">
+        <Image
+          unoptimized
+          fill
+          sizes="(max-width: 768px) 100vw, 768px"
+          src={"/api/cotizacion-compartida/" + encodeURIComponent(token) + "/imagen"}
+          alt={"Vista de la escena " + quote.sceneName}
+          className="rounded-2xl border border-borde-suave bg-superficie object-contain"
+        />
+      </div>
+      <section aria-label="Precio de la cotización" className="rounded-2xl border border-borde-suave bg-superficie p-5">
+        <p className="text-sm text-texto-suave">Total para el cliente</p>
+        <p className="mt-1 text-3xl font-semibold tabular-nums">{currency.format(quote.totalCop)}</p>
+        <p className="mt-3 text-sm text-texto-suave">Válida hasta el {formatValidUntil(quote.validUntil)}.</p>
+      </section>
+      {status !== "pending" ? (
+        <p role="status" className="rounded-xl bg-superficie p-4 text-sm">{STATUS_LABEL[status]}.</p>
+      ) : !canRespond ? (
+        <p role="status" className="rounded-xl bg-superficie p-4 text-sm">La respuesta está temporalmente deshabilitada.</p>
+      ) : (
+        <form onSubmit={(event) => void submit(event)} className="flex flex-col gap-3 rounded-2xl border border-borde-suave bg-superficie p-5">
+          <h2 className="text-lg font-semibold">¿Apruebas esta cotización?</h2>
+          <label className="flex min-h-11 items-center gap-2 text-sm">
+            <input type="radio" name="decision" checked={decision === "approved"} onChange={() => setDecision("approved")} />
+            Aprobar
+          </label>
+          <label className="flex min-h-11 items-center gap-2 text-sm">
+            <input type="radio" name="decision" checked={decision === "changes_requested"} onChange={() => setDecision("changes_requested")} />
+            Pedir cambios
+          </label>
+          <label htmlFor="customer-name" className="text-sm font-medium">Tu nombre</label>
+          <input id="customer-name" value={name} onChange={(event) => setName(event.target.value)} required maxLength={100}
+            className="min-h-11 rounded-lg border border-borde-suave bg-fondo px-3 text-sm focus-visible:outline-2 focus-visible:outline-acento" />
+          {decision === "changes_requested" && (
+            <>
+              <label htmlFor="customer-comment" className="text-sm font-medium">¿Qué cambios necesitas?</label>
+              <textarea id="customer-comment" value={comment} onChange={(event) => setComment(event.target.value)} required maxLength={2000} rows={4}
+                className="rounded-lg border border-borde-suave bg-fondo px-3 py-2 text-sm focus-visible:outline-2 focus-visible:outline-acento" />
+            </>
+          )}
+          {error && <p role="alert" className="text-sm text-error">{error}</p>}
+          <button type="submit" disabled={submitting} className="min-h-11 rounded-xl bg-acento px-4 text-sm font-semibold text-sobre-acento disabled:opacity-60">
+            {submitting ? "Enviando…" : decision === "approved" ? "Confirmar aprobación" : "Enviar solicitud de cambios"}
+          </button>
+        </form>
+      )}
+    </main>
+  );
+}
diff --git a/src/components/shared-quotes/OwnerSharedQuotes.tsx b/src/components/shared-quotes/OwnerSharedQuotes.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..f71c95ad93e684bd330f87c695b1bcc15073b2d6
--- /dev/null
+++ b/src/components/shared-quotes/OwnerSharedQuotes.tsx
@@ -0,0 +1,120 @@
+"use client";
+
+import { useCallback, useEffect, useRef, useState } from "react";
+import { z } from "zod";
+import type { OwnerSharedQuote } from "@/lib/shared-quotes/contracts";
+import { BTN } from "@/components/tres-d/ui-taller";
+
+const OwnerListSchema = z.object({
+  quotes: z.array(z.object({
+    id: z.string().uuid(),
+    sceneName: z.string(),
+    validUntil: z.string(),
+    status: z.enum(["pending", "approved", "changes_requested"]),
+    customerName: z.string().nullable(),
+    comment: z.string().nullable(),
+    respondedAt: z.string().nullable(),
+    createdAt: z.string(),
+  }).strict()),
+}).strict();
+
+const STATUS_LABEL: Record<OwnerSharedQuote["status"], string> = {
+  pending: "Pendiente",
+  approved: "Aprobada",
+  changes_requested: "Cambios solicitados",
+};
+
+const dateTime = new Intl.DateTimeFormat("es-CO", {
+  dateStyle: "medium",
+  timeStyle: "short",
+  timeZone: "America/Bogota",
+});
+function formatResponseDate(value: string): string {
+  return dateTime.format(new Date(value));
+}
+
+export function OwnerSharedQuotes({ sceneKey, enabled }: { sceneKey: string; enabled: boolean }) {
+  const [quoteState, setQuoteState] = useState<{ sceneKey: string; quotes: OwnerSharedQuote[] } | null>(null);
+  const [errorState, setErrorState] = useState<{ sceneKey: string; message: string } | null>(null);
+  const [refreshingSceneKey, setRefreshingSceneKey] = useState<string | null>(null);
+  const requestVersion = useRef(0);
+
+  const quotes = quoteState?.sceneKey === sceneKey ? quoteState.quotes : [];
+  const loading = refreshingSceneKey === sceneKey || quoteState?.sceneKey !== sceneKey;
+  const error = errorState?.sceneKey === sceneKey ? errorState.message : null;
+
+  const loadQuotes = useCallback(async (): Promise<OwnerSharedQuote[]> => {
+    const query = new URLSearchParams({ sceneKey });
+    const response = await fetch("/api/taller/cotizaciones-compartidas?" + query.toString(), {
+      credentials: "same-origin",
+      cache: "no-store",
+    });
+    if (!response.ok) throw new Error("No pude cargar las respuestas.");
+    return OwnerListSchema.parse(await response.json()).quotes;
+  }, [sceneKey]);
+
+  const refresh = useCallback(async () => {
+    if (!enabled) return;
+    const version = ++requestVersion.current;
+    setRefreshingSceneKey(sceneKey);
+    setErrorState(null);
+    try {
+      const loadedQuotes = await loadQuotes();
+      if (requestVersion.current !== version) return;
+      setQuoteState({ sceneKey, quotes: loadedQuotes });
+    } catch {
+      if (requestVersion.current === version) setErrorState({ sceneKey, message: "No pude cargar las respuestas de esta escena." });
+    } finally {
+      if (requestVersion.current === version) setRefreshingSceneKey(null);
+    }
+  }, [enabled, loadQuotes, sceneKey]);
+
+  useEffect(() => {
+    if (!enabled) return;
+    const version = ++requestVersion.current;
+    let active = true;
+    void loadQuotes().then((loadedQuotes) => {
+      if (!active || requestVersion.current !== version) return;
+      setQuoteState({ sceneKey, quotes: loadedQuotes });
+      setErrorState(null);
+      setRefreshingSceneKey(null);
+    }).catch(() => {
+      if (!active || requestVersion.current !== version) return;
+      setQuoteState({ sceneKey, quotes: [] });
+      setErrorState({ sceneKey, message: "No pude cargar las respuestas de esta escena." });
+      setRefreshingSceneKey(null);
+    });
+    return () => { active = false; };
+  }, [enabled, loadQuotes, sceneKey]);
+
+  if (!enabled) return null;
+  return (
+    <section aria-label="Respuestas a cotizaciones compartidas" className="mt-4 border-t border-taller-linea pt-3">
+      <div className="flex items-center justify-between gap-2">
+        <h5 className="text-sm font-semibold">Respuestas del cliente</h5>
+        <button type="button" className={BTN} disabled={loading} onClick={() => void refresh()}>{loading ? "Actualizando…" : "Actualizar"}</button>
+      </div>
+      {error && <p role="alert" className="mt-2 text-sm text-red-600">{error}</p>}
+      {!loading && !error && quotes.length === 0 && <p className="mt-2 text-xs text-taller-suave">Esta escena aún no tiene enlaces compartidos.</p>}
+      <OwnerSharedQuoteList quotes={quotes} />
+    </section>
+  );
+}
+
+export function OwnerSharedQuoteList({ quotes }: { quotes: OwnerSharedQuote[] }) {
+  return (
+    <ul className="mt-2 flex flex-col gap-3">
+      {quotes.map((quote) => (
+        <li key={quote.id} className="rounded-lg bg-taller-superficie p-3 text-sm">
+          <p className="font-medium">{quote.sceneName} · {STATUS_LABEL[quote.status]} · válida hasta {quote.validUntil}</p>
+          {quote.customerName && (
+            <p className="mt-1">
+              {quote.customerName}{quote.respondedAt ? " · " + formatResponseDate(quote.respondedAt) : ""}
+            </p>
+          )}
+          {quote.comment && <p className="mt-2 whitespace-pre-wrap break-words" aria-label="Comentario del cliente">{quote.comment}</p>}
+        </li>
+      ))}
+    </ul>
+  );
+}
diff --git a/src/components/shared-quotes/ShareQuoteControl.tsx b/src/components/shared-quotes/ShareQuoteControl.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..a96bff78478be4ad23a521af59ffdc8c9d3ac52b
--- /dev/null
+++ b/src/components/shared-quotes/ShareQuoteControl.tsx
@@ -0,0 +1,175 @@
+"use client";
+
+import { useState, type FormEvent } from "react";
+import { z } from "zod";
+import type { EntradaCotizacionProfesional } from "@/lib/cotizacion/profesional";
+import { MAX_SHARED_STILL_BYTES } from "@/lib/shared-quotes/contracts";
+import { tomorrowInBogota } from "@/lib/shared-quotes/dates";
+import { BTN } from "@/components/tres-d/ui-taller";
+
+const CreateResponseSchema = z.object({
+  path: z.string().startsWith("/cotizacion-compartida/"),
+  validUntil: z.string(),
+}).strict();
+
+async function encodeJpeg(canvas: HTMLCanvasElement, quality: number): Promise<Blob> {
+  return new Promise((resolve, reject) => {
+    canvas.toBlob((blob) => blob ? resolve(blob) : reject(new Error("El navegador no pudo comprimir la imagen.")), "image/jpeg", quality);
+  });
+}
+
+export async function compressSharedStill(png: Blob): Promise<Blob> {
+  const bitmap = await createImageBitmap(png);
+  const canvas = document.createElement("canvas");
+  try {
+    for (const scale of [1, 0.85, 0.7, 0.55]) {
+      const longestSide = Math.max(bitmap.width, bitmap.height);
+      const targetSide = Math.min(1200, Math.max(1, Math.round(longestSide * scale)));
+      const ratio = targetSide / longestSide;
+      canvas.width = Math.max(1, Math.round(bitmap.width * ratio));
+      canvas.height = Math.max(1, Math.round(bitmap.height * ratio));
+      const context = canvas.getContext("2d");
+      if (!context) throw new Error("El navegador no pudo preparar la imagen.");
+      context.drawImage(bitmap, 0, 0, canvas.width, canvas.height);
+      for (const quality of [0.82, 0.68, 0.54]) {
+        const compressed = await encodeJpeg(canvas, quality);
+        if (compressed.size > 0 && compressed.size <= MAX_SHARED_STILL_BYTES) return compressed;
+      }
+    }
+    throw new Error("La imagen de la escena supera el tamaño permitido.");
+  } finally {
+    bitmap.close();
+    canvas.width = 0;
+    canvas.height = 0;
+  }
+}
+
+function blobToBase64(blob: Blob): Promise<string> {
+  return new Promise((resolve, reject) => {
+    const reader = new FileReader();
+    reader.onload = () => {
+      const result = reader.result;
+      if (typeof result !== "string") return reject(new Error("No se pudo preparar la imagen."));
+      const separator = result.indexOf(",");
+      if (separator < 0) return reject(new Error("No se pudo preparar la imagen."));
+      resolve(result.slice(separator + 1));
+    };
+    reader.onerror = () => reject(new Error("No se pudo leer la imagen."));
+    reader.readAsDataURL(blob);
+  });
+}
+
+export function ShareQuoteControl({
+  enabled,
+  ready,
+  sceneName,
+  sceneKey,
+  quoteInput,
+  captureStill,
+}: {
+  enabled: boolean;
+  ready: boolean;
+  sceneName: string;
+  sceneKey: string;
+  quoteInput: EntradaCotizacionProfesional | null;
+  captureStill: () => Promise<Blob>;
+}) {
+  const [open, setOpen] = useState(false);
+  const [minimumDate, setMinimumDate] = useState("");
+  const [validUntil, setValidUntil] = useState("");
+  const [submitting, setSubmitting] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  const [url, setUrl] = useState<string | null>(null);
+  const [copied, setCopied] = useState(false);
+
+  async function createLink(event: FormEvent<HTMLFormElement>) {
+    event.preventDefault();
+    if (!ready || !quoteInput || !validUntil || submitting) return;
+    setSubmitting(true);
+    setError(null);
+    setUrl(null);
+    try {
+      const still = await compressSharedStill(await captureStill());
+      const response = await fetch("/api/taller/cotizaciones-compartidas", {
+        method: "POST",
+        headers: { "Content-Type": "application/json" },
+        credentials: "same-origin",
+        body: JSON.stringify({
+          sceneName,
+          sceneKey,
+          validUntil,
+          quoteInput,
+          stillBase64: await blobToBase64(still),
+        }),
+      });
+      const body: unknown = await response.json().catch(() => null);
+      if (!response.ok) {
+        const parsedError = z.object({ message: z.string().optional() }).safeParse(body);
+        throw new Error(parsedError.success && parsedError.data.message ? parsedError.data.message : "No pude crear el enlace.");
+      }
+      const parsed = CreateResponseSchema.parse(body);
+      setUrl(new URL(parsed.path, window.location.origin).toString());
+      setOpen(false);
+    } catch (cause: unknown) {
+      setError(cause instanceof Error ? cause.message : "No pude crear el enlace.");
+    } finally {
+      setSubmitting(false);
+    }
+  }
+
+  async function copyLink() {
+    if (!url) return;
+    try {
+      await navigator.clipboard.writeText(url);
+      setCopied(true);
+    } catch {
+      setCopied(false);
+    }
+  }
+
+  function toggleForm() {
+    if (!open) {
+      const nextDate = tomorrowInBogota(new Date());
+      setMinimumDate(nextDate);
+      setValidUntil((current) => current && current >= nextDate ? current : nextDate);
+    }
+    setOpen(!open);
+    setError(null);
+  }
+
+  if (!enabled) return null;
+  return (
+    <section aria-label="Compartir cotización para aprobación" className="mt-4 border-t border-borde-suave pt-3">
+      <button type="button" className={BTN} disabled={!ready || submitting} onClick={toggleForm}>
+        {submitting ? "Creando enlace…" : open ? "Cerrar enlace compartido" : "Compartir para aprobación"}
+      </button>
+      {!ready && <p className="mt-2 text-xs text-texto-suave">Espera a que el precio termine de calcularse antes de compartir.</p>}
+      {open && (
+        <form className="mt-3 flex flex-col gap-2" onSubmit={(event) => void createLink(event)}>
+          <label htmlFor="quote-valid-until" className="text-sm font-medium">Cotización válida hasta</label>
+          <input
+            id="quote-valid-until"
+            type="date"
+            min={minimumDate}
+            value={validUntil}
+            onChange={(event) => setValidUntil(event.target.value)}
+            required
+            className="min-h-11 rounded-lg border border-borde-suave bg-superficie px-3 text-sm text-texto focus-visible:outline-2 focus-visible:outline-acento"
+          />
+          <p className="text-xs text-texto-suave">El enlace vence al terminar este día en Colombia.</p>
+          <button type="submit" className={BTN} disabled={!ready || !minimumDate || submitting}>
+            {submitting ? "Preparando escena y precio…" : "Crear enlace"}
+          </button>
+        </form>
+      )}
+      {error && <p role="alert" className="mt-2 text-sm text-error">{error}</p>}
+      {url && (
+        <div className="mt-3 flex flex-col gap-2">
+          <label htmlFor="quote-share-url" className="text-sm font-medium">Enlace · válido hasta {validUntil}</label>
+          <input id="quote-share-url" readOnly value={url} className="min-h-11 w-full rounded-lg border border-borde-suave bg-superficie px-3 text-xs text-texto" />
+          <button type="button" className={BTN} onClick={() => void copyLink()}>{copied ? "Enlace copiado" : "Copiar enlace"}</button>
+        </div>
+      )}
+    </section>
+  );
+}
diff --git a/src/components/shared-quotes/SharedQuoteFlags.tsx b/src/components/shared-quotes/SharedQuoteFlags.tsx
