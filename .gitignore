# machine-local state of the bitácora (sessions, repo paths, server token, launch scripts)
bitacora/.state/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
*.tmp
evals/results/
# build output of `uv tool install --editable`
*.egg-info/
# images in the bitácora stay local: the remote does not keep them (owner, 2026-10-19)
bitacora/**/*.png
bitacora/**/*.jpg
bitacora/**/*.jpeg
bitacora/**/*.webp
bitacora/**/*.gif
.vercel
.env*
